{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}",
        "{tools,scripts}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}",
      ],
      "vitest": { "entry": ["tools/**/*.{test,spec}.{ts,mjs}"] },
    },
    "tools/release": {
      "entry": ["node-consumer.mjs", "browser-consumer.ts", "browser-duckdb-consumer.ts"],
    },
    "packages/catalog": {
      // Cross-language contract tests invoke the repository's Python toolchain.
      "ignoreBinaries": ["uv"],
    },
    "apps/chat": {
      "entry": [
        "agent/tools/*.ts",
        "agent/skills/*.ts",
        "agent/instrumentation/*.ts",
        "evals/**/*.ts",
      ],
      "babel": true,
    },
  },
}
