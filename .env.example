# ------------------------------
# Shared (Python + eval-ui server)
# ------------------------------

# OpenAI-compatible API endpoint + key (used by the Python retrieval tooling).
OPENAI_BASE_URL=http://localhost:8317/v1
OPENAI_API_KEY=sk-...

# Path to the local catalog parquet (used by Python retrieval server/CLI).
CHARTCOACH_CATALOG_PATH=guidelines/catalog.parquet

# S3 / S3-compatible object storage (used by Python tooling and eval-ui server for artifact IO/sync).
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET=...
S3_PREFIX=chartcoach
S3_FORCE_PATH_STYLE=false

# ------------------------------
# apps/site (Astro)
# ------------------------------

# Canonical site URL for sitemap + canonical links.
# Used by `apps/site/astro.config.mjs`.
SITE_URL=https://example.com

# ------------------------------
# apps/eval-ui (TanStack Start)
# ------------------------------

# Optional: override the app title shown in the UI.
VITE_APP_TITLE=Chart Coach Eval

# Link template used to deep-link guideline cards to the guideline browser.
# Use `{id}` as the placeholder; example:
#   https://example.com/guidelines/{id}/
VITE_GUIDELINE_DETAIL_URL_TEMPLATE=http://localhost:4321/guidelines/{id}/

# Optional: point eval-ui at a different artifacts root (otherwise fixtures are used).
# Examples:
#   file:///absolute/path/to/eval-artifacts/v1/
#   https://example.com/eval-artifacts/v1/
#   s3://my-bucket/some/prefix/eval-artifacts/v1/
EVAL_ARTIFACTS_URL=

# Optional: artifacts schema/version tag (defaults to "v1" in code).
EVAL_ARTIFACTS_VERSION=v1

