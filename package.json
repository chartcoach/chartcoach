{
	"name": "chartcoach",
	"private": true,
	"version": "0.0.1",
	"scripts": {
		"dev": "pnpm --filter site dev",
		"dev:site": "pnpm --filter site dev",
		"dev:eval": "pnpm --filter @chartcoach/eval-ui dev",
		"build": "pnpm --filter site build",
		"build:site": "pnpm --filter site build",
		"build:eval": "pnpm --filter @chartcoach/eval-ui build",
		"preview": "pnpm --filter site preview",
		"preview:site": "pnpm --filter site preview",
		"preview:eval": "pnpm --filter @chartcoach/eval-ui preview",
		"test:eval": "pnpm --filter @chartcoach/eval-ui test",
		"lint:js": "oxlint apps/site apps/eval-ui",
		"format:js": "oxfmt apps/site apps/eval-ui"
	},
	"devDependencies": {
		"oxfmt": "^0.26.0",
		"oxlint": "^1.41.0"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"pnpm": {
		"onlyBuiltDependencies": [
			"citation-js",
			"esbuild",
			"sharp"
		]
	},
	"packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
