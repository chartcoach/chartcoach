{
	"name": "chartcoach",
	"private": true,
	"version": "0.0.1",
	"scripts": {
		"dev": "pnpm --filter site dev",
		"dev:site": "pnpm --filter site dev",
		"dev:eval": "pnpm --filter @chartcoach/eval-ui dev",
		"build": "pnpm --filter site... build",
		"build:site": "pnpm --filter site... build",
		"build:eval": "pnpm --filter @chartcoach/eval-ui... build",
		"preview": "pnpm --filter site preview",
		"preview:site": "pnpm --filter site preview",
		"preview:eval": "pnpm --filter @chartcoach/eval-ui preview",
		"test:eval": "pnpm --filter @chartcoach/eval-ui test",
		"validate:catalog": "uv run python -m chartcoach.catalog.validate --folder guidelines --parquet guidelines/catalog.parquet",
		"lint:js": "oxlint apps/site apps/eval-ui",
		"format:js": "oxfmt apps/site apps/eval-ui"
	},
	"devDependencies": {
		"eslint-plugin-better-tailwindcss": "^4.0.2",
		"oxfmt": "^0.26.0",
		"oxlint": "^1.42.0"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"pnpm": {
		"onlyBuiltDependencies": [
			"@firebase/util",
			"citation-js",
			"esbuild",
			"protobufjs",
			"rxdb",
			"sharp"
		]
	},
	"packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
