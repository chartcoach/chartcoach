{
  "name": "chartcoach",
  "version": "0.1.6",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "portless",
    "format": "oxfmt package.json pnpm-workspace.yaml .github/workflows/ci.yml .github/workflows/publish.yml && pnpm -r --if-present format",
    "format:check": "oxfmt --check package.json pnpm-workspace.yaml .github/workflows/ci.yml .github/workflows/publish.yml && pnpm -r --if-present format:check",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.26.0",
    "oxlint": "^1.70.0",
    "portless": "^0.14.0",
    "typescript": "^5.9.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
