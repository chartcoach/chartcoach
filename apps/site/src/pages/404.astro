---
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout title="Not found" description="The requested chartcoach page could not be found.">
  <section class="px-6 py-[clamp(5rem,14vh,9rem)]">
    <div class="mx-auto w-full max-w-[42rem] text-center">
      <h1 class="m-0 text-[2.75rem] font-semibold leading-[1.02] tracking-normal text-fg sm:text-[3.5rem] lg:text-[4.5rem]">
        Not found
      </h1>
      <p class="m-0 mt-6 text-[1.0625rem] leading-[1.65] text-muted">The page is not in the chartcoach site.</p>
      <a
        href="/"
        class="mt-9 inline-flex h-11 items-center justify-center rounded-lg border border-fg bg-fg px-4 text-sm font-medium text-bg no-underline transition-colors hover:bg-fg/90"
      >
        Return home
      </a>
    </div>
  </section>
</SiteLayout>
