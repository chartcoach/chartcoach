---
import notFound from "@chartcoach/brand/assets/brand/not-found.svg";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE_PATHS } from "@/lib/routes";
import { ArrowRight, Home } from "lucide-react";

const description =
  "Explore source-traced visualization guidance in the Guideline Catalog, or return to the chartcoach overview.";
---

<SiteLayout
  title="Page not found"
  description={description}
  og={{
    kind: "page",
    eyebrow: "chartcoach 404",
    title: "That page is missing.",
    description,
    metaItems: ["Guideline Catalog"],
  }}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <img src={notFound.src} alt="" width="440" height="300" class="not-found-art" />
    <div class="not-found-copy">
      <p class="not-found-eyebrow">404 / Page not found</p>
      <h1 id="not-found-title">That page is missing.</h1>
      <p class="not-found-description">{description}</p>
      <nav aria-label="Page recovery" class="not-found-actions">
        <a href={SITE_PATHS.guidelines} class="not-found-primary">
          Browse guidelines <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a href={SITE_PATHS.home} class="not-found-secondary">
          <Home size={18} aria-hidden="true" /> Return home
        </a>
      </nav>
    </div>
  </section>
</SiteLayout>

<style>
  .not-found {
    display: grid;
    flex: 1;
    grid-template-columns: 1fr;
    align-content: center;
    align-items: center;
    gap: 28px;
    width: min(calc(100% - 40px), 480px);
    margin-inline: auto;
    padding-block: 64px;
  }

  .not-found-art {
    width: 100%;
    height: auto;
  }

  .not-found-copy {
    min-width: 0;
  }

  .not-found-eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--color-accent) 85%, var(--color-fg));
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 16px 0 0;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .not-found-description {
    max-width: 400px;
    margin: 20px 0 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .not-found-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
    touch-action: manipulation;
  }

  .not-found-actions a:focus-visible {
    outline: 2px solid var(--color-muted);
    outline-offset: 2px;
  }

  .not-found-primary {
    background: var(--color-fg);
    color: var(--color-bg);
    font-weight: 500;
  }

  .not-found-secondary {
    color: var(--color-muted);
  }

  @media (max-width: 520px) {
    .not-found {
      padding-block: 40px;
    }
  }

  @media (min-width: 1100px), (min-width: 600px) and (max-height: 620px) {
    .not-found {
      grid-template-columns: 1fr 1fr;
      gap: clamp(24px, 6vw, 96px);
      width: min(calc(100% - 2 * clamp(20px, 5vw, 80px)), 1080px);
    }
  }

  @media (max-height: 620px) {
    .not-found {
      padding-block: 16px;
    }

    h1 {
      margin-top: 12px;
      font-size: 28px;
    }

    .not-found-description {
      margin-top: 12px;
      font-size: 14px;
      line-height: 1.5;
    }

    .not-found-actions {
      gap: 8px;
      margin-top: 16px;
    }
  }
</style>
