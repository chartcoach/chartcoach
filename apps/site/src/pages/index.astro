---
import { InstallCopy } from "@/components/install-copy";
import { GuidelineStory } from "@/components/guideline-story";
import SvgIcon from "@/components/SvgIcon.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { EXTERNAL_HREFS, SITE_PATHS } from "@/lib/routes";
import { ArrowRight, Mail } from "lucide-react";

const pageDescription =
  "chartcoach helps chart agents review charts with guidance they can inspect and cite.";

const loopSteps = [
  {
    label: "Human",
    title: "Chart request",
    body: "A person asks an agent to review, recommend, evaluate, or explain a chart decision.",
  },
  {
    label: "Agent",
    title: "Guideline retrieval",
    body: "The agent searches the Guideline Catalog by label, section role, reference, and semantic match.",
  },
  {
    label: "Answer",
    title: "Grounded response",
    body: "The answer cites the guideline entries it used and names the guidance applied to the chart.",
  },
  {
    label: "Community",
    title: "Public contribution",
    body: "When guidance is missing, weak, or contested, the agent drafts a catalog issue after receiving confirmation so the community can review the proposed guideline entry.",
  },
] as const;

const institutions = [
  {
    icon: "eth-zurich",
    label: "ETH Zürich",
    href: "https://ethz.ch/en.html",
  },
  {
    icon: "carnegie-mellon",
    label: "Carnegie Mellon University",
    href: "https://www.cmu.edu/",
  },
  {
    icon: "university-vienna",
    label: "University of Vienna",
    href: "https://www.univie.ac.at/en/",
  },
  {
    icon: "mbzuai",
    label: "MBZUAI",
    href: "https://mbzuai.ac.ae/",
  },
] as const;
---

<SiteLayout
  title="chartcoach"
  description={pageDescription}
  og={{
    kind: "home",
    eyebrow: "Guideline Catalog",
    title: "Visualization guidelines agents can cite.",
    description:
      "Visualization guidelines that agents retrieve, cite, apply, and improve, each linked back to its sources.",
    verbs: ["Review", "Recommend", "Discuss", "Evaluate", "Contribute"],
  }}
>
  <section class="home-hero relative z-20 flex items-start overflow-visible px-6 pb-[clamp(4.5rem,9vh,6.5rem)] pt-12 sm:pt-[clamp(4rem,11vh,7rem)] lg:min-h-[calc(100svh-3.5rem)] lg:items-center lg:pb-[clamp(1.5rem,3.2vh,3rem)] lg:pt-[clamp(1.5rem,3.2vh,3rem)]">
    <div class="grid-glow" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto flex w-full max-w-[72rem] flex-col items-center text-center">
      <p class="home-hero-kicker mb-6 mt-0 inline-flex items-center rounded-full border border-border bg-surface/70 px-3.5 py-1 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.16em] text-muted backdrop-blur sm:mb-7 lg:mb-5 xl:mb-6">
        Experimental
      </p>
      <h1 class="home-hero-title m-0 max-w-[58rem] text-balance text-[2.35rem] font-semibold leading-[1.02] tracking-normal text-fg sm:text-[3.75rem] lg:text-[4.25rem] xl:max-w-[66rem] xl:text-[4.8rem] 2xl:text-[5.05rem]">
        Visualization guidelines agents can inspect and cite
      </h1>
      <p class="home-hero-copy mt-5 max-w-[50rem] text-pretty text-[1rem] leading-[1.6] text-muted sm:mt-6 sm:text-[1.25rem] sm:leading-[1.65] lg:mt-5 lg:text-[1.125rem] lg:leading-[1.55] xl:max-w-[54rem] xl:text-[1.1875rem]">
        chartcoach helps agents retrieve, inspect, cite, apply, and improve visualization
        guidelines. Each guideline links to its sources, so agents can explain where guidance comes
        from when reviewing charts, recommending encodings, and evaluating trade-offs.
      </p>
      <InstallCopy client:load />
      <div class="home-loop mt-16 w-full max-w-[72rem] text-left sm:mt-[4.5rem] lg:mt-16 xl:mt-20">
        <p class="m-0 mb-4 font-mono text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-muted">
          Agent workflow
        </p>
        <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
          {
            loopSteps.map((step, index) => (
              <article class="home-loop-card group relative flex min-h-[16rem] flex-col bg-bg p-6 transition-colors duration-200 hover:bg-surface-muted sm:p-7 lg:min-h-[13.75rem] lg:p-5 xl:min-h-[14.25rem] xl:p-6">
                <div class="home-loop-card-header mb-7 flex items-center gap-2.5 lg:mb-5">
                  <span class="home-loop-card-index flex h-7 w-7 items-center justify-center rounded-md border border-border font-mono text-[0.75rem] tabular-nums text-muted transition-colors group-hover:border-fg/40 group-hover:text-fg">
                    {index + 1}
                  </span>
                  <span class="home-loop-card-label font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-muted lg:text-[0.625rem]">
                    {step.label}
                  </span>
                </div>
                <h3 class="home-loop-card-title m-0 text-[1.25rem] font-semibold leading-snug tracking-normal text-fg lg:text-[1.125rem] xl:text-[1.1875rem]">
                  {step.title}
                </h3>
                <p class="home-loop-card-copy m-0 mt-3 text-[0.9375rem] leading-[1.65] text-muted lg:mt-2.5 lg:text-[0.875rem] lg:leading-[1.5] xl:text-[0.9375rem]">
                  {step.body}
                </p>
                {index < loopSteps.length - 1 && (
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute right-0 top-1/2 z-10 hidden -translate-y-1/2 translate-x-[calc(50%+1px)] lg:flex"
                  >
                    <span class="flex h-7 w-7 items-center justify-center rounded-full border border-border bg-bg text-muted">
                      <ArrowRight className="h-3.5 w-3.5" strokeWidth={1.5} />
                    </span>
                  </span>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <GuidelineStory client:load />

  <section class="relative z-10 border-t border-border px-6 py-[clamp(5.5rem,12vh,8rem)]">
    <div class="mx-auto w-full max-w-[72rem]">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div>
          <p class="m-0 font-mono text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-muted">
            Research
          </p>
          <h2 class="m-0 mt-5 max-w-[42rem] text-[2.5rem] font-semibold leading-[1.02] tracking-normal text-fg sm:text-[3.25rem] lg:text-[3.9rem] xl:max-w-[56rem] xl:text-[4.35rem]">
            Backed by research
          </h2>
          <div class="mt-7 max-w-[44rem] space-y-5 text-pretty text-[1.0625rem] leading-[1.65] text-muted xl:max-w-[61rem] xl:text-[1.1875rem]">
            <p class="m-0">
              chartcoach is developed by researchers from ETH Zürich, Carnegie Mellon University,
              the University of Vienna, and MBZUAI. It builds on work in visualization
              recommendation, chart linting, rule-based systems like{" "}
              <a
                href="https://github.com/cmudig/draco2"
                target="_blank"
                rel="noreferrer"
                class="font-medium text-fg underline decoration-border decoration-1 underline-offset-[0.18em] transition-colors hover:decoration-fg"
              >{"Draco"}</a><span>, accessibility guidance, data journalism, and </span>
              <a
                href="https://talking-charts.vda.univie.ac.at/talkingcharts.html"
                target="_blank"
                rel="noreferrer"
                class="font-medium text-fg underline decoration-border decoration-1 underline-offset-[0.18em] transition-colors hover:decoration-fg"
              >{"situated visualization feedback"}</a><span>.</span>
            </p>
            <p class="m-0">
              The Guideline Catalog brings that research into a form agents can cite and
              people can author, review, and inspect.
            </p>
          </div>
        </div>
        <div class="flex lg:justify-end">
          <a
            href={EXTERNAL_HREFS.paper}
            target="_blank"
            rel="noreferrer"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-border bg-bg px-4 text-sm font-medium text-fg no-underline transition-colors hover:bg-surface-muted xl:text-[0.9375rem]"
          >
            Read the paper
            <ArrowRight className="h-3.5 w-3.5" strokeWidth={1.5} aria-hidden="true" />
          </a>
        </div>
      </div>
      <ul class="m-0 mt-12 grid list-none grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border p-0 lg:grid-cols-4" aria-label="Research institutions">
        {
          institutions.map((institution) => (
            <li class="bg-bg">
              <a
                href={institution.href}
                target="_blank"
                rel="noreferrer"
                aria-label={institution.label}
                class="research-logo-link flex h-24 items-center justify-center bg-bg px-4 no-underline transition-colors hover:bg-surface-muted sm:h-28"
              >
                <span
                  class:list={[
                    "research-logo-stack",
                    institution.icon === "carnegie-mellon" ? "research-logo-stack--square" : "",
                  ]}
                  aria-hidden="true"
                >
                  <SvgIcon name={institution.icon} tone="mono" class="svg-icon research-logo-icon research-logo-icon--mono" />
                  <SvgIcon name={institution.icon} tone="color" class="svg-icon research-logo-icon research-logo-icon--color" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative z-10 border-t border-border">
    <div class="mx-auto flex w-[min(100%-3rem,var(--container-content))] flex-col items-center px-6 py-[clamp(6rem,14vh,9rem)] text-center">
      <p class="m-0 mb-5 font-mono text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-muted">
        Experimental
      </p>
      <h2 class="m-0 max-w-[42rem] text-[2rem] font-semibold leading-[1.02] tracking-normal text-fg sm:text-[2.75rem] lg:text-[3.5rem] xl:text-[4rem]">
        Actively developed
      </h2>
      <p class="mx-auto mt-6 max-w-[43rem] text-pretty text-[1.0625rem] leading-[1.6] text-muted xl:text-[1.1875rem]">
        chartcoach is a research prototype for chart agents, critique tools, evaluation
        workflows, and visualization design systems. Browse the Guideline Catalog, request
        missing guidance in GitHub, or contact the research team about deployment and
        collaboration.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={EXTERNAL_HREFS.docsGettingStarted}
          class="inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-accent bg-accent px-4 text-sm font-medium text-white no-underline transition-colors hover:bg-accent/90 xl:text-[0.9375rem]"
        >
          Try chartcoach
          <ArrowRight className="h-3.5 w-3.5" strokeWidth={1.5} aria-hidden="true" />
        </a>
        <a
          href={SITE_PATHS.guidelines}
          class="inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-border bg-bg px-4 text-sm font-medium text-fg no-underline transition-colors hover:bg-surface-muted xl:text-[0.9375rem]"
        >
          Browse the Guideline Catalog
          <ArrowRight className="h-3.5 w-3.5" strokeWidth={1.5} aria-hidden="true" />
        </a>
        <a
          href={EXTERNAL_HREFS.contact}
          class="inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-border bg-bg px-4 text-sm font-medium text-fg no-underline transition-colors hover:bg-surface-muted xl:text-[0.9375rem]"
        >
          Get in touch
          <Mail className="h-3.5 w-3.5" strokeWidth={1.5} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
