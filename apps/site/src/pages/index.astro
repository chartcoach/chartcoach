---
import HomeHero from "@/components/home/HomeHero.astro";
import HomeResearch from "@/components/home/HomeResearch.astro";
import HomeGetStarted from "@/components/home/HomeGetStarted.astro";
import { GuidelineStory } from "@/components/guideline-story";
import SiteLayout from "@/layouts/SiteLayout.astro";
import "@/styles/home.css";

const pageDescription =
  "chartcoach helps chart agents review charts with guidance they can inspect and cite.";
---

<SiteLayout
  title="chartcoach"
  description={pageDescription}
  og={{
    kind: "home",
    eyebrow: "Guideline Catalog",
    title: "Visualization guidelines agents can cite.",
    description:
      "Visualization guidelines that agents retrieve, cite, apply, and improve, each linked back to its sources.",
    verbs: ["Review", "Recommend", "Discuss", "Evaluate", "Contribute"],
  }}
>
  <HomeHero />
  <HomeResearch />
  <GuidelineStory client:visible />
  <HomeGetStarted />
</SiteLayout>
