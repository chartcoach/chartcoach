---
import { getCollection } from "astro:content";

import SiteLayout from "@/layouts/SiteLayout.astro";

const guidelines = (await getCollection("guidelines")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<SiteLayout title="Guidelines" description="List of ChartCoach guidelines.">
  <p><a href="/">ChartCoach</a></p>
  <h1>Guidelines</h1>
  <p>{guidelines.length.toLocaleString()} guidelines.</p>
  <ol>
    {
      guidelines.map((guideline) => (
        <li>
          <a href={`/guidelines/${guideline.id}/`}>{guideline.data.title}</a>
        </li>
      ))
    }
  </ol>
</SiteLayout>
