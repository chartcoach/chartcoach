---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { encodeGuidelineLabelQueryValue, parseGuidelineLabel } from "@chartcoach/site/lib/guidelines/labels";
import { createGuidelinePageFrontmatter } from "@chartcoach/site/lib/site-metadata";
import GuidelineCard from "@chartcoach/site/components/guidelines/GuidelineCard.astro";

const guidelines = (await getCollection("guidelines")).sort((a, b) =>
	(a.data.title ?? a.id).localeCompare(b.data.title ?? b.id),
);

const totalGuidelines = guidelines.length;
const MAX_CARD_LABELS = 4;

const labelSet = new Set<string>();
const familySet = new Set<string>();
for (const guideline of guidelines) {
	for (const label of guideline.data.labels ?? []) {
		const parsed = parseGuidelineLabel(label);
		labelSet.add(parsed.fullLower);
		if (parsed.familyLower) familySet.add(parsed.familyLower);
	}
}

const allLabels = Array.from(labelSet).sort((a, b) => a.localeCompare(b));
const allFamilies = Array.from(familySet).sort((a, b) => a.localeCompare(b));
---

<StarlightPage
	hasSidebar={false}
	frontmatter={createGuidelinePageFrontmatter({
		title: "Guidelines",
		description: "Browse the Chartcoach guideline catalog.",
	})}
>
	<div class="not-content guidelines-page mx-auto w-full max-w-[64rem] pt-4">
		<p class="m-0 mb-2 font-mono text-[0.72rem] font-bold lowercase tracking-[0.04em] text-muted-foreground">
			catalog
		</p>
		<h1 class="m-0 text-[clamp(1.55rem,3vw,2.1rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-foreground [font-family:var(--cc-site-font-display)]">
			Guidelines
		</h1>
		<p class="mt-2 max-w-[46rem] text-[0.96rem] leading-[1.55] text-muted-foreground">
			Browse the Chart Coach catalog as structured guideline records.
		</p>
		<div class="guidelines-controls mt-4 flex flex-col items-stretch gap-4 border-b border-border pb-4">
			<div class="min-w-[14rem]">
				<div
					class="font-mono text-[0.78rem] font-bold lowercase tracking-[0.02em] text-foreground"
					id="guidelines-count"
					data-total-guidelines={totalGuidelines}
					role="status"
					aria-live="polite"
					aria-atomic="true"
				>
					{totalGuidelines.toLocaleString()} guidelines
				</div>
				<p class="mt-2 text-[0.88rem] leading-[1.55] text-muted-foreground" id="guidelines-filter-hint">
					Filter by labels (e.g., <code>chart</code> or <code>chart:bar</code>), use the arrow keys to review suggestions, and press Enter to add one.
				</p>
			</div>

			<form
				class="guidelines-filter-form relative grid w-full max-w-[18rem] grid-cols-[minmax(0,1fr)_auto] overflow-visible rounded-[3px] border border-input bg-background"
				id="guidelines-filter-form"
				autocomplete="off"
			>
				<label class="sr-only" for="guidelines-filter-input">Add label filter</label>
				<input
					class="w-full appearance-none border-0 bg-transparent px-3 py-2 text-[0.88rem] font-medium leading-[1.2] text-foreground placeholder:text-muted-foreground focus:outline-none"
					type="text"
					id="guidelines-filter-input"
					name="label"
					placeholder="Add a label filter…"
					autocomplete="off"
					spellcheck="false"
					role="combobox"
					aria-autocomplete="list"
					aria-expanded="false"
					aria-haspopup="listbox"
					aria-controls="guidelines-label-suggestions"
					aria-describedby="guidelines-filter-hint guidelines-count"
				/>
				<button
					class="cursor-pointer border-0 border-l border-border bg-muted px-3 py-2 font-mono text-[0.74rem] font-bold lowercase tracking-[0.02em] text-foreground transition-colors hover:bg-secondary"
					type="submit"
					aria-label="Add filter"
				>
					Add
				</button>
				<div
					class="guidelines-suggestions"
					id="guidelines-label-suggestions"
					role="listbox"
					aria-label="Label suggestions"
					hidden
				/>
			</form>
		</div>

		<div
			class="guidelines-filters mt-3 flex w-full flex-wrap items-center gap-2 [&[hidden]]:!hidden"
			id="guidelines-filters"
			hidden
		>
			<span class="font-mono text-[0.74rem] font-bold lowercase tracking-[0.02em] text-muted-foreground">
				Filters:
			</span>
			<ul class="m-0 flex list-none flex-wrap gap-1.5 p-0" id="guidelines-filters-list"></ul>
			<button
				class="cursor-pointer border-0 bg-transparent px-1 py-0.5 font-mono text-[0.72rem] font-bold lowercase tracking-[0.02em] text-muted-foreground transition-colors hover:text-foreground hover:underline hover:underline-offset-[0.16em]"
				type="button"
				id="guidelines-filters-clear"
				aria-label="Clear all filters"
			>
				Clear
			</button>
		</div>

		<ul class="guidelines-grid mt-8 grid w-full list-none gap-4 p-0" id="guidelines-grid">
			{
				guidelines.map((g) => {
					const title = g.data.title ?? g.id;
					const description = g.data.description ?? "";
					const labels = g.data.labels ?? [];
					const cardLabels = labels.map((l) => l.toLowerCase()).join("|");
					const labelsShown = labels.slice(0, MAX_CARD_LABELS);
					const labelsRemaining = Math.max(0, labels.length - labelsShown.length);

					return (
						<GuidelineCard
							dataLabels={cardLabels}
							href={`/guidelines/${g.id}/`}
							title={title}
							description={description || undefined}
							labels={labelsShown.map((label) => {
								const parsed = parseGuidelineLabel(label);

								if (parsed.family) {
									const familyLower = parsed.familyLower ?? parsed.family.toLowerCase();

									return {
										family: {
											text: parsed.family,
											href: `/guidelines/?label=${encodeURIComponent(encodeGuidelineLabelQueryValue(familyLower))}`,
											filterValue: familyLower,
											title: `Filter: ${parsed.family}`,
										},
										value: {
											text: parsed.value,
											href: `/guidelines/?label=${encodeURIComponent(encodeGuidelineLabelQueryValue(parsed.fullLower))}`,
											filterValue: parsed.fullLower,
											title: `Filter: ${parsed.full}`,
										},
									};
								}

								return {
									value: {
										text: parsed.value,
										href: `/guidelines/?label=${encodeURIComponent(encodeGuidelineLabelQueryValue(parsed.fullLower))}`,
										filterValue: parsed.fullLower,
										title: `Filter: ${parsed.value}`,
									},
								};
							})}
							labelsRemaining={labelsRemaining || undefined}
						/>
					);
				})
			}
		</ul>

		<script
			is:inline
			type="application/json"
			id="guidelines-label-suggestions-data"
			set:html={JSON.stringify({ families: allFamilies, labels: allLabels })}
		></script>
		<script src="@chartcoach/site/scripts/guidelines/label-filters.entry.ts"></script>
	</div>
</StarlightPage>
