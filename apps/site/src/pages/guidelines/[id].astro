---
import { getCollection, getEntry } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import {
  GuidelineDetailView,
  type GuidelineCardLabel,
} from "@chartcoach/chartcoach-ui";
import { encodeGuidelineLabelQueryValue, parseGuidelineLabel } from "@chartcoach/site/lib/guidelines/labels";

export async function getStaticPaths() {
	const guidelines = await getCollection("guidelines");
	return guidelines.map((g) => ({
		params: { id: g.id },
	}));
}

const guidelinesShareImage = "/social/chartcoach-share-guidelines.png";
const guideline = await getEntry("guidelines", Astro.params.id as string);
if (!guideline) throw new Error(`Guideline not found: ${Astro.params.id}`);
---

<StarlightPage
		hasSidebar={false}
	frontmatter={{
		title: guideline.data.title ?? guideline.id,
		description: guideline.data.description,
		tableOfContents: false,
		head: [
			{
				tag: "meta",
				attrs: { property: "og:image", content: guidelinesShareImage },
			},
			{
				tag: "meta",
				attrs: { name: "twitter:image", content: guidelinesShareImage },
			},
		],
	}}
>
	<div class="guideline-detail">
		<GuidelineDetailView
			id={guideline.id}
			title={guideline.data.title ?? guideline.id}
			description={guideline.data.description}
			labels={guideline.data.labels.map((label) => {
				const parsed = parseGuidelineLabel(label);

				if (parsed.family) {
					const familyLower = parsed.familyLower ?? parsed.family.toLowerCase();

					return {
						family: {
							text: parsed.family,
							href: `/guidelines/?label=${encodeURIComponent(encodeGuidelineLabelQueryValue(familyLower))}`,
							filterValue: familyLower,
							title: `Filter: ${parsed.family}`,
						},
						value: {
							text: parsed.value,
							href: `/guidelines/?label=${encodeURIComponent(encodeGuidelineLabelQueryValue(parsed.fullLower))}`,
							filterValue: parsed.fullLower,
							title: `Filter: ${parsed.full}`,
						},
					};
				}

				return {
					value: {
						text: parsed.value,
						href: `/guidelines/?label=${encodeURIComponent(encodeGuidelineLabelQueryValue(parsed.fullLower))}`,
						filterValue: parsed.fullLower,
						title: `Filter: ${parsed.value}`,
					},
				};
			}) as GuidelineCardLabel[]}
			sections={guideline.data.sections}
			bibliographyHtml={guideline.data.bibliographyHtml}
			referencesBib={guideline.data.referencesBib}
		/>
	</div>
</StarlightPage>
