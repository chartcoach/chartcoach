---
import { BookOpenText, FolderTree, ListFilter, ScrollText } from "@lucide/astro";

interface Props {
  href: string;
  title: string;
  description: string;
  icon: "catalog" | "labels" | "structure" | "citations";
}

const { href, title, description, icon } = Astro.props as Props;

const iconByName = {
  catalog: BookOpenText,
  labels: ListFilter,
  structure: FolderTree,
  citations: ScrollText,
} as const;

const Icon = iconByName[icon];
---

<a
  class="flex gap-3 rounded-[4px] border border-chip-border bg-surface px-[1.02rem] py-4 text-card-foreground no-underline shadow-card transition-colors hover:border-control-border hover:bg-surface-strong hover:text-foreground focus-visible:no-underline"
  href={href}
>
  <span
    aria-hidden="true"
    class="grid size-[2.2rem] place-items-center rounded-[3px] border border-control-border bg-surface-strong text-brand-high"
  >
    <Icon class="size-[1.1rem]" aria-hidden="true" focusable="false" />
  </span>
  <span class="flex min-w-0 flex-col gap-1">
    <span class="text-[0.95rem] font-semibold leading-5">{title}</span>
    <span class="text-[0.88rem] leading-[1.55] text-muted-foreground">{description}</span>
  </span>
</a>
