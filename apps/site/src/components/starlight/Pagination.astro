---
import { ArrowLeft, ArrowRight } from "@lucide/astro";

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const pathname = Astro.url.pathname;
const isRtl = dir === "rtl";
const isGuidelinesIndex = pathname === "/guidelines" || pathname === "/guidelines/";

const shouldRender = pathname !== "/" && !isGuidelinesIndex && (prev || next);
const cardClasses =
  "grid items-center gap-x-2 rounded-none border border-border bg-muted px-3 py-3 text-foreground no-underline transition-colors hover:border-foreground/20 hover:bg-accent hover:text-accent-foreground focus-visible:border-foreground/20 focus-visible:bg-accent focus-visible:text-accent-foreground";
const labelClasses = "grid min-w-0 gap-px";
---

{
  shouldRender && (
    <nav
      class="grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(14rem,100%),1fr))] print:hidden"
      aria-label="Pagination"
    >
      {
        prev ? (
          <a
            class:list={[cardClasses, "grid-cols-[auto_minmax(0,1fr)]"]}
            href={prev.href}
            rel="prev"
          >
            {isRtl ? (
              <ArrowRight size="1rem" />
            ) : (
              <ArrowLeft size="1rem" />
            )}
            <span class={labelClasses}>
              <span class="text-[0.65rem] font-mono uppercase tracking-[0.05em] text-muted-foreground">
                {Astro.locals.t("page.previousLink")}
              </span>
              <span class="text-base font-semibold leading-[1.3] text-inherit">{prev.label}</span>
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            class:list={[cardClasses, "grid-cols-[minmax(0,1fr)_auto]"]}
            href={next.href}
            rel="next"
          >
            <span class:list={[labelClasses, "justify-items-end text-right"]}>
              <span class="text-[0.65rem] font-mono uppercase tracking-[0.05em] text-muted-foreground">
                {Astro.locals.t("page.nextLink")}
              </span>
              <span class="text-base font-semibold leading-[1.3] text-inherit">{next.label}</span>
            </span>
            {isRtl ? (
              <ArrowLeft size="1rem" />
            ) : (
              <ArrowRight size="1rem" />
            )}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  )
}
