---
import { ArrowLeft, ArrowRight } from "lucide-astro";

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const pathname = Astro.url.pathname;
const isRtl = dir === "rtl";

const shouldRender = pathname !== "/" && (prev || next);
---

{
	shouldRender && (
		<nav
			class="cc-pagination grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(14rem,100%),1fr))] print:hidden"
			aria-label="Pagination"
		>
			{
				prev ? (
					<a
						class="grid grid-cols-[auto,minmax(0,1fr)] items-center gap-x-2 rounded-md border border-border bg-muted px-3 py-3 text-foreground no-underline transition-colors hover:border-foreground/20 hover:bg-accent hover:text-accent-foreground focus-visible:border-foreground/20 focus-visible:bg-accent focus-visible:text-accent-foreground"
						href={prev.href}
						rel="prev"
					>
						{isRtl ? (
							<ArrowRight class="cc-pagination__icon" size="1rem" />
						) : (
							<ArrowLeft class="cc-pagination__icon" size="1rem" />
						)}
						<span class="grid min-w-0 gap-px">
							<span class="text-[0.65rem] font-mono uppercase tracking-[0.05em] text-muted-foreground">
								{Astro.locals.t("page.previousLink")}
							</span>
							<span class="text-base font-semibold leading-[1.3] text-inherit">{prev.label}</span>
						</span>
					</a>
				) : (
					<span />
				)
			}
			{
				next ? (
					<a
						class="grid grid-cols-[minmax(0,1fr),auto] items-center gap-x-2 rounded-md border border-border bg-muted px-3 py-3 text-foreground no-underline transition-colors hover:border-foreground/20 hover:bg-accent hover:text-accent-foreground focus-visible:border-foreground/20 focus-visible:bg-accent focus-visible:text-accent-foreground"
						href={next.href}
						rel="next"
					>
						<span class="grid min-w-0 justify-items-end gap-px text-right">
							<span class="text-[0.65rem] font-mono uppercase tracking-[0.05em] text-muted-foreground">
								{Astro.locals.t("page.nextLink")}
							</span>
							<span class="text-base font-semibold leading-[1.3] text-inherit">{next.label}</span>
						</span>
						{isRtl ? (
							<ArrowLeft class="cc-pagination__icon" size="1rem" />
						) : (
							<ArrowRight class="cc-pagination__icon" size="1rem" />
						)}
					</a>
				) : (
					<span />
				)
			}
		</nav>
	)
}
