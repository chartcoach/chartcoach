---
import { ChartCoachMarimekkoMark } from "@chartcoach/ui/components/chartcoach-marimekko-mark";

const accessibleName = "ChartCoach";
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a
  href={siteTitleHref}
  class="site-title"
  data-site-title
  aria-label={accessibleName}
>
  <span class="sr-only">{accessibleName}</span>
  <span class="site-title__mark" aria-hidden="true">
    <ChartCoachMarimekkoMark
      idPrefix="cc-site-title-mark"
      mode="static"
      theme="auto"
      title="ChartCoach"
      style={{ width: "2.3rem" }}
    />
  </span>
</a>

<script is:inline>
  const TITLE_ANIMATION_DURATION = 720;

  const easeInOutCubic = (value) =>
    value < 0.5 ? 4 * value * value * value : 1 - Math.pow(-2 * value + 2, 3) / 2;

  const attributes = ["x", "y", "width", "height", "rx"];

  const stateDatasetKey = (prefix, attribute) =>
    `${prefix}${attribute.charAt(0).toUpperCase()}${attribute.slice(1)}`;

  const readState = (rect, prefix) =>
    Object.fromEntries(
      attributes.map((attribute) => [attribute, Number.parseFloat(rect.dataset[stateDatasetKey(prefix, attribute)])]),
    );

  const readCurrentState = (rect) =>
    Object.fromEntries(
      attributes.map((attribute) => [attribute, Number.parseFloat(rect.getAttribute(attribute) ?? "0")]),
    );

  const applyState = (rect, state) => {
    attributes.forEach((attribute) => {
      rect.setAttribute(attribute, String(state[attribute]));
    });
  };

  const interpolate = (from, to, progress) =>
    Object.fromEntries(
      attributes.map((attribute) => [attribute, from[attribute] + (to[attribute] - from[attribute]) * progress]),
    );

  document.querySelectorAll("[data-site-title]").forEach((link) => {
    const rects = Array.from(link.querySelectorAll("#cc-site-title-mark-svg rect[data-cc-block]"));
    if (rects.length === 0) return;

    let frameId = 0;
    let animationToken = 0;

    const cancelAnimation = () => {
      animationToken += 1;
      if (frameId) {
        cancelAnimationFrame(frameId);
        frameId = 0;
      }
    };

    const setState = (prefix) => {
      cancelAnimation();
      rects.forEach((rect) => applyState(rect, readState(rect, prefix)));
      link.dataset.state = prefix === "start" ? "unstructured" : "structured";
    };

    const animateTo = (prefix) => {
      cancelAnimation();
      const token = animationToken;
      const startTime = performance.now();
      const fromStates = rects.map((rect) => readCurrentState(rect));
      const toStates = rects.map((rect) => readState(rect, prefix));
      const phaseName = prefix === "start" ? "entering" : "releasing";
      const settledName = prefix === "start" ? "unstructured" : "structured";

      const step = (now) => {
        if (token !== animationToken) return;
        const elapsed = Math.min(1, (now - startTime) / TITLE_ANIMATION_DURATION);
        const eased = easeInOutCubic(elapsed);

        rects.forEach((rect, index) => {
          applyState(rect, interpolate(fromStates[index], toStates[index], eased));
        });

        if (elapsed < 1) {
          frameId = requestAnimationFrame(step);
        } else {
          frameId = 0;
          link.dataset.state = settledName;
        }
      };

      link.dataset.state = phaseName;
      frameId = requestAnimationFrame(step);
    };

    const activate = () => {
      if (link.dataset.state === "entering" || link.dataset.state === "unstructured") return;
      animateTo("start");
    };

    const release = () => {
      requestAnimationFrame(() => {
        if (link.matches(":hover") || link.matches(":focus-within")) return;
        if (link.dataset.state === "releasing" || link.dataset.state === "structured") return;
        animateTo("end");
      });
    };

    setState("end");

    link.addEventListener("pointerenter", activate);
    link.addEventListener("pointerleave", release);
    link.addEventListener("focusin", activate);
    link.addEventListener("focusout", release);
  });
</script>

<style>
  @layer starlight.core {
    .site-title {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 1.95rem;
      width: 2.3rem;
      min-width: 2.3rem;
      color: var(--cc-brand-high);
      text-decoration: none;
    }

    .site-title__mark {
      display: grid;
      place-items: center;
      width: 2.3rem;
      height: 2.3rem;
      flex: none;
      transform: translateY(0.28rem);
    }

    .site-title:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--cc-brand) 24%, transparent);
      outline-offset: 4px;
      border-radius: 0.5rem;
    }
  }
</style>
