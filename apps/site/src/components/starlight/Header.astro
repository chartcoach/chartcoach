---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "./SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import { Menu, X } from "@lucide/astro";
import { headerNavigation } from "../../../config/navigation";

const pathname = Astro.url.pathname;

function normalizePath(value: string) {
	if (value === "/") return "/";
	return value.endsWith("/") ? value : `${value}/`;
}

const currentPath = normalizePath(pathname);
const mobileMenuPanelId = "cc-mobile-menu-panel";
const mobileMenuToggleLabelId = "cc-mobile-menu-toggle-label";
const desktopNavLinkBase =
	"relative inline-flex min-h-[1.95rem] items-center px-[0.68rem] py-[0.24rem] font-sans text-[0.78rem] font-semibold leading-none tracking-[-0.01em] no-underline transition-colors lg:text-[0.82rem]";
const desktopNavLinkInactive = "text-muted-foreground";
const desktopNavLinkActive = "text-brand-high";
const mobileNavLinkBase =
	"flex min-h-11 items-center rounded-none border border-transparent px-[0.7rem] py-[0.55rem] font-sans text-[0.9rem] font-semibold no-underline transition-colors";
const mobileNavLinkInactive =
	"text-muted-foreground hover:border-control-border hover:bg-surface-strong hover:text-foreground focus-visible:border-control-border focus-visible:bg-surface-strong focus-visible:text-foreground";
const mobileNavLinkActive = "border-control-border bg-surface text-brand-high";

function isActive(href: string) {
	const target = normalizePath(href);
	if (target === "/") return currentPath === "/";
	return currentPath === target || currentPath.startsWith(target);
}
---

<div class="grid min-h-full content-center">
	<div class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-[0.6rem] lg:grid-cols-[auto_minmax(0,1fr)_auto_auto] lg:gap-x-[0.95rem]">
		<div class="min-w-0">
			<SiteTitle />
		</div>

		<nav
			class="hidden min-w-0 items-center gap-[0.28rem] lg:flex lg:justify-start"
			aria-label="Primary"
			data-site-header-nav
		>
			{
				headerNavigation.map((item) => {
					const isCurrent = isActive(item.href);

					return (
						<a
							class:list={[
								desktopNavLinkBase,
								isCurrent ? desktopNavLinkActive : desktopNavLinkInactive,
							]}
							href={item.href}
							aria-current={isCurrent ? "page" : undefined}
							data-header-link
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>

		<div class="flex min-w-max justify-end justify-self-end" data-site-header-search>
			<Search />
		</div>

		<div class="hidden items-center lg:flex" data-site-header-controls>
			<div class="social-icons flex items-center gap-3" data-site-header-social>
				<SocialIcons />
			</div>
			<ThemeSelect />
		</div>

		<details class="m-0 justify-self-end lg:hidden" data-mobile-menu>
			<summary
				class="inline-flex size-11 items-center justify-center rounded-none border border-control-border bg-control text-muted-foreground transition-colors focus-visible:border-control-border focus-visible:bg-surface-strong focus-visible:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring/30"
				aria-controls={mobileMenuPanelId}
				aria-expanded="false"
				aria-labelledby={mobileMenuToggleLabelId}
				data-mobile-menu-toggle
			>
				<span class="sr-only" id={mobileMenuToggleLabelId}>Open primary menu</span>
				<Menu
					class="size-4"
					data-mobile-menu-icon="open"
					size="1rem"
					aria-hidden="true"
					focusable="false"
				/>
				<X
					class="size-4"
					data-mobile-menu-icon="close"
					size="1rem"
					aria-hidden="true"
					focusable="false"
				/>
			</summary>
			<div
				class="fixed inset-x-0 top-[var(--sl-nav-height)] z-[var(--sl-z-index-menu)] grid gap-[0.85rem] border-t border-border bg-background px-4 py-4 shadow-popover"
				id={mobileMenuPanelId}
			>
					<nav class="grid gap-[0.2rem]" aria-label="Primary mobile">
						{
							headerNavigation.map((item) => {
								const isCurrent = isActive(item.href);

								return (
									<a
										class:list={[
											mobileNavLinkBase,
											isCurrent ? mobileNavLinkActive : mobileNavLinkInactive,
										]}
										href={item.href}
										aria-current={isCurrent ? "page" : undefined}
									>
										{item.label}
									</a>
								);
							})
						}
					</nav>
				<div class="flex items-center justify-end gap-[0.9rem] border-t border-border pt-[0.55rem]">
					<div class="social-icons flex min-h-[2.2rem] items-center gap-3" data-mobile-menu-social>
						<SocialIcons />
					</div>
					<div class="flex min-h-[2.2rem] items-center">
						<ThemeSelect />
					</div>
				</div>
			</div>
		</details>
	</div>
</div>

<script is:inline>
	document.querySelectorAll("[data-mobile-menu]").forEach((details) => {
		const summary = details.querySelector("summary");
		const summaryLabel = details.querySelector("#cc-mobile-menu-toggle-label");
		const syncMenuState = () => {
			if (!(summary instanceof HTMLElement)) return;
			summary.setAttribute("aria-expanded", details.open ? "true" : "false");
			if (summaryLabel instanceof HTMLElement) {
				summaryLabel.textContent = details.open ? "Close primary menu" : "Open primary menu";
			}
		};
		const closeMenu = () => {
			details.open = false;
		};

		syncMenuState();
		details.addEventListener("toggle", syncMenuState);

		details.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", closeMenu);
		});

		window.addEventListener("click", (event) => {
			if (details.open && !details.contains(event.target)) closeMenu();
		});

		window.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && details.open) {
				const hadFocus = details.contains(document.activeElement);
				closeMenu();
				if (hadFocus && summary instanceof HTMLElement) summary.focus();
			}
		});
	});
</script>
