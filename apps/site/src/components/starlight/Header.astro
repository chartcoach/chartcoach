---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import { Menu, X } from "lucide-astro";
import { headerNavigation } from "../../../config/navigation";

const pathname = Astro.url.pathname;

function normalizePath(value: string) {
	if (value === "/") return "/";
	return value.endsWith("/") ? value : `${value}/`;
}

const currentPath = normalizePath(pathname);
const mobileMenuPanelId = "cc-mobile-menu-panel";
const mobileMenuToggleLabelId = "cc-mobile-menu-toggle-label";

function isActive(href: string) {
	const target = normalizePath(href);
	if (target === "/") return currentPath === "/";
	return currentPath === target || currentPath.startsWith(target);
}
---

<div class="cc-site-header">
	<div class="cc-site-header__row--primary">
		<div class="cc-site-header__brand">
			<SiteTitle />
		</div>

		<nav class="cc-site-header__nav cc-site-header__nav--desktop" aria-label="Primary">
			{
				headerNavigation.map((item) => (
					<a
						class="cc-site-header__nav-link"
						href={item.href}
						aria-current={isActive(item.href) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="cc-site-header__search">
			<Search class="cc-site-search" />
		</div>

		<div class="cc-site-header__controls">
			<div class="cc-site-header__social social-icons">
				<SocialIcons />
			</div>
			<ThemeSelect />
		</div>

		<details class="cc-mobile-menu">
			<summary
				class="cc-mobile-menu__toggle"
				aria-controls={mobileMenuPanelId}
				aria-expanded="false"
				aria-labelledby={mobileMenuToggleLabelId}
			>
				<span class="sr-only" id={mobileMenuToggleLabelId}>Open primary menu</span>
				<Menu
					class="cc-mobile-menu__icon cc-mobile-menu__icon--open"
					size="1rem"
					aria-hidden="true"
					focusable="false"
				/>
				<X
					class="cc-mobile-menu__icon cc-mobile-menu__icon--close"
					size="1rem"
					aria-hidden="true"
					focusable="false"
				/>
			</summary>
			<div class="cc-mobile-menu__panel" id={mobileMenuPanelId}>
				<nav class="cc-mobile-menu__links" aria-label="Primary mobile">
					{
						headerNavigation.map((item) => (
							<a
								class="cc-mobile-menu__link"
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="cc-mobile-menu__footer">
					<div class="cc-mobile-menu__social social-icons">
						<SocialIcons />
					</div>
					<div class="cc-mobile-menu__theme">
						<ThemeSelect />
					</div>
				</div>
			</div>
		</details>
	</div>
</div>

<script is:inline>
	document.querySelectorAll(".cc-mobile-menu").forEach((details) => {
		const summary = details.querySelector("summary");
		const summaryLabel = details.querySelector("#cc-mobile-menu-toggle-label");
		const syncMenuState = () => {
			if (!(summary instanceof HTMLElement)) return;
			summary.setAttribute("aria-expanded", details.open ? "true" : "false");
			if (summaryLabel instanceof HTMLElement) {
				summaryLabel.textContent = details.open ? "Close primary menu" : "Open primary menu";
			}
		};
		const closeMenu = () => {
			details.open = false;
		};

		syncMenuState();
		details.addEventListener("toggle", syncMenuState);

		details.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", closeMenu);
		});

		window.addEventListener("click", (event) => {
			if (details.open && !details.contains(event.target)) closeMenu();
		});

		window.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && details.open) {
				const hadFocus = details.contains(document.activeElement);
				closeMenu();
				if (hadFocus && summary instanceof HTMLElement) summary.focus();
			}
		});
	});
</script>
