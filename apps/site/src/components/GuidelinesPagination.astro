---
import {
  GUIDELINES_PER_PAGE,
  getGuidelinesPageHref,
} from "@/lib/guidelines-pagination";

type Props = {
  currentPage: number;
  totalPages: number;
  totalRecords: number;
  class?: string;
};

type PaginationItem =
  | {
      type: "page";
      key: string;
      page: number;
      href: string;
      current: boolean;
    }
  | {
      type: "ellipsis";
      key: string;
    };

const { currentPage, totalPages, totalRecords, class: className = "" } = Astro.props;
const previousHref = currentPage > 1 ? getGuidelinesPageHref(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? getGuidelinesPageHref(currentPage + 1) : null;
const firstRecord = totalRecords === 0 ? 0 : (currentPage - 1) * GUIDELINES_PER_PAGE + 1;
const lastRecord = totalRecords === 0 ? 0 : Math.min(currentPage * GUIDELINES_PER_PAGE, totalRecords);
const rootClass = [
  "flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between",
  className,
]
  .filter(Boolean)
  .join(" ");

function createPaginationItems(page: number, total: number): PaginationItem[] {
  const pages = new Set([1, total]);

  for (let offset = -2; offset <= 2; offset += 1) {
    const candidate = page + offset;
    if (candidate >= 1 && candidate <= total) pages.add(candidate);
  }

  const sortedPages = Array.from(pages).sort((a, b) => a - b);
  const items: PaginationItem[] = [];
  let previousPage = 0;

  for (const pageNumber of sortedPages) {
    if (previousPage > 0 && pageNumber - previousPage > 1) {
      items.push({
        type: "ellipsis",
        key: `ellipsis-${previousPage}-${pageNumber}`,
      });
    }

    items.push({
      type: "page",
      key: `page-${pageNumber}`,
      page: pageNumber,
      href: getGuidelinesPageHref(pageNumber),
      current: pageNumber === page,
    });

    previousPage = pageNumber;
  }

  return items;
}

const paginationItems = createPaginationItems(currentPage, totalPages);
---

{
  totalPages > 1 && (
    <nav class={rootClass} aria-label="Guidelines pagination">
      <p class="m-0 text-sm text-muted">
        Showing {firstRecord.toLocaleString()}-{lastRecord.toLocaleString()} of {totalRecords.toLocaleString()} guidelines.
      </p>
      <div class="flex flex-wrap items-center gap-2">
        {previousHref ? (
          <a
            href={previousHref}
            class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-fg no-underline transition-colors hover:bg-surface-muted"
          >
            Previous
          </a>
        ) : (
          <span class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-muted opacity-50">
            Previous
          </span>
        )}
        {
          paginationItems.map((item) => (
            <>
              {item.type === "ellipsis" && (
                <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-muted" aria-hidden="true">
                  ...
                </span>
              )}
              {item.type === "page" && item.current && (
                <span
                  class="inline-flex h-9 min-w-9 items-center justify-center rounded-md border border-accent bg-accent px-3 text-sm font-medium text-white"
                  aria-current="page"
                >
                  {item.page}
                </span>
              )}
              {item.type === "page" && !item.current && (
                <a
                  href={item.href}
                  class="inline-flex h-9 min-w-9 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-fg no-underline transition-colors hover:bg-surface-muted"
                >
                  {item.page}
                </a>
              )}
            </>
          ))
        }
        {nextHref ? (
          <a
            href={nextHref}
            class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-fg no-underline transition-colors hover:bg-surface-muted"
          >
            Next
          </a>
        ) : (
          <span class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-muted opacity-50">
            Next
          </span>
        )}
      </div>
    </nav>
  )
}
