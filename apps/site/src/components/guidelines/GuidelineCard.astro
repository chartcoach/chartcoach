---
import GuidelineLabels from "./GuidelineLabels.astro";
import type { GuidelineCardLabel } from "./types";

interface Props {
  href: string;
  title: string;
  description?: string;
  dataLabels?: string;
  labels: GuidelineCardLabel[];
  labelsRemaining?: number;
}

const { href, title, description, dataLabels, labels = [], labelsRemaining } = Astro.props as Props;
---

<li
  class="list-none rounded-sm border border-line bg-[color-mix(in_srgb,var(--canvas)_78%,var(--layer))] px-3.5 py-3.5 text-ink shadow-card transition-colors hover:border-[var(--line-strong)] hover:bg-surface focus-within:border-[var(--line-strong)] focus-within:bg-surface focus-within:ring-2 focus-within:ring-ring/30 focus-within:ring-offset-2 focus-within:ring-offset-background md:px-4 md:py-4"
  data-guideline-card
  data-labels={dataLabels}
>
  <div class="grid min-w-0 gap-1.5 md:gap-2">
    <a
      class="block font-display text-[1.08rem] font-semibold leading-[1.18] tracking-[0] text-foreground no-underline hover:text-brand-high focus-visible:text-brand-high md:text-[1.2rem]"
      href={href}
    >
      {title}
    </a>
    {description ? <p class="m-0 text-[0.88rem] leading-[1.5] text-muted-foreground md:text-sm md:leading-6">{description}</p> : null}
    {
      labels.length || labelsRemaining ? (
        <GuidelineLabels
          className="pt-0.5"
          labels={labels as GuidelineCardLabel[]}
          labelsRemaining={labelsRemaining}
          variant="chip-compact"
        />
      ) : null
    }
  </div>
</li>
