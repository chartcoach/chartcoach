---
import GuidelineLabels from "./GuidelineLabels.astro";
import type { GuidelineCardLabel } from "./types";

interface Props {
  href: string;
  title: string;
  description?: string;
  dataLabels?: string;
  labels: GuidelineCardLabel[];
  labelsRemaining?: number;
}

const { href, title, description, dataLabels, labels = [], labelsRemaining } = Astro.props as Props;
---

<li
  class="list-none rounded-panel border border-chip-border bg-surface px-4 py-4 text-card-foreground shadow-card transition-colors hover:border-control-border hover:bg-surface-strong focus-within:border-control-border focus-within:bg-surface-strong focus-within:ring-2 focus-within:ring-ring/30 focus-within:ring-offset-2 focus-within:ring-offset-background"
  data-guideline-card
  data-labels={dataLabels}
>
  <div class="grid min-w-0 gap-2">
    <a
      class="block font-display text-[clamp(1.05rem,1vw+0.85rem,1.2rem)] font-semibold leading-[1.18] tracking-[-0.015em] text-foreground no-underline hover:text-brand-high focus-visible:text-brand-high"
      href={href}
    >
      {title}
    </a>
    {description ? <p class="m-0 text-sm leading-6 text-muted-foreground">{description}</p> : null}
    {
      labels.length || labelsRemaining ? (
        <GuidelineLabels
          className="pt-0.5"
          labels={labels as GuidelineCardLabel[]}
          labelsRemaining={labelsRemaining}
          variant="chip-compact"
        />
      ) : null
    }
  </div>
</li>
