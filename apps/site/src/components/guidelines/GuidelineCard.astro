---
import {
  GuidelineCard as SharedGuidelineCard,
  type GuidelineCardLabel,
} from "@chartcoach/chartcoach-ui";

interface Props {
  href: string;
  title: string;
  description?: string;
  dataLabels?: string;
  labels: GuidelineCardLabel[];
  labelsRemaining?: number;
}

const { href, title, description, dataLabels, labels = [], labelsRemaining } = Astro.props as Props;
---

<SharedGuidelineCard
  href={href}
  title={title}
  description={description}
  dataLabels={dataLabels}
  labels={labels as GuidelineCardLabel[]}
  labelsRemaining={labelsRemaining}
/>
