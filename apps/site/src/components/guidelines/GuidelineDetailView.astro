---
import GuidelineLabels from "./GuidelineLabels.astro";
import GuidelineCopyMarkdown from "./GuidelineCopyMarkdown.astro";
import type { GuidelineCardLabel, GuidelineDetailSection } from "./types";

interface Props {
  id: string;
  title: string;
  description?: string;
  labels: GuidelineCardLabel[];
  markdown: string;
  sections: GuidelineDetailSection[];
  bibliographyHtml?: string;
  referencesBib?: string;
}

const { id, title, description, labels, markdown, sections, bibliographyHtml, referencesBib } =
  Astro.props as Props;
---

<div class="mx-auto grid min-w-0 w-full max-w-[62rem] gap-[0.85rem]">
  <div class="grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
    <div class="grid min-w-0 gap-1">
      <h1 class="m-0 text-balance font-display text-[1.55rem] font-semibold leading-[1.06] tracking-[0] text-foreground md:text-[1.95rem]">
        {title}
      </h1>
      {description ? <p class="m-0 max-w-3xl text-[0.92rem] leading-[1.58] text-muted-foreground">{description}</p> : null}
    </div>
    <div class="justify-self-start sm:justify-self-end">
      <GuidelineCopyMarkdown id={id} markdown={markdown} />
    </div>
  </div>

  {
    labels.length ? (
      <section
        aria-label="Guideline labels"
        class="grid min-w-0 gap-2 border-t border-border pt-3"
      >
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-[0.66rem] font-bold uppercase tracking-[0] text-muted-foreground">
            labels
          </span>
        </div>
        <GuidelineLabels className="gap-2" labels={labels} />
      </section>
    ) : null
  }

  {
    sections.length ? (
      <div class="grid min-w-0 gap-7 pt-2 sm:gap-8">
        {sections.map((section) => (
          <section class="min-w-0">
            <div class="grid min-w-0 gap-2">
              <p class="m-0 font-mono text-[0.58rem] font-semibold leading-[0.98] tracking-[0] text-muted-foreground/80 lowercase">
                {section.role}
              </p>
              <h2 class="m-0 text-balance font-display text-[1.45rem] font-semibold leading-[0.99] tracking-[0] text-foreground md:text-[1.82rem]">
                {section.title}
              </h2>
              <div class="guideline-article-section__body" set:html={section.html} />
            </div>
          </section>
        ))}
      </div>
    ) : null
  }

  {
    bibliographyHtml ? (
      <section class="grid min-w-0 gap-2 pt-2">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-[0.66rem] font-bold uppercase tracking-[0] text-muted-foreground">
            references
          </span>
        </div>
        <div class="bibliography" set:html={bibliographyHtml} />

        {
          referencesBib ? (
            <details class="mt-4 grid min-w-0 grid-cols-[minmax(0,1fr)] gap-0">
              <summary class="flex min-h-8 min-w-0 !w-full cursor-pointer items-center px-0 font-mono text-[0.75rem] font-bold tracking-[0] text-foreground">
                Show BibTeX
              </summary>
              <pre class="mt-1 min-w-0 !w-full !max-w-full overflow-x-auto whitespace-pre-wrap break-words rounded-sm border border-border bg-muted p-4"><code class="whitespace-pre-wrap break-words">{referencesBib}</code></pre>
            </details>
          ) : null
        }
      </section>
    ) : null
  }
</div>
