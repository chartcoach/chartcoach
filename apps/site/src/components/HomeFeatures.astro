---
import FeatureCard from "./home/FeatureCard.astro";

const bodyClasses = "m-0 text-[0.96rem] leading-[1.65] text-muted-foreground";
---

<section class="grid gap-6 md:gap-7" aria-labelledby="cc-home-explore-title">
  <div class="grid gap-2.5">
    <div class="grid max-w-3xl gap-[0.45rem]">
      <h2
        id="cc-home-explore-title"
        class="m-0 font-display text-[clamp(1.7rem,2vw,2.2rem)] font-semibold leading-[1.08] tracking-[-0.025em] text-foreground"
      >
        Explore the catalog
      </h2>
      <p class={bodyClasses}>
        Browse guidelines, use labels to narrow the list, and follow citations back to the source
        material.
      </p>
    </div>

    <div
      class="grid items-stretch gap-4 md:grid-cols-2"
      aria-label="Explore ChartCoach"
    >
      <FeatureCard
        description="Read compact records with advice, context, caveats, and references."
        href="/guidelines/"
        icon="catalog"
        title="Browse the catalog"
      />
      <FeatureCard
        description="Narrow by task, chart family, audience, or design move."
        href="/labels/"
        icon="labels"
        title="Filter by labels"
      />
      <FeatureCard
        description="See the fields every catalog entry can use."
        href="/catalog/"
        icon="structure"
        title="Inspect the structure"
      />
      <FeatureCard
        description="Move from a claim to the bibliography behind it."
        href="/catalog/#references"
        icon="citations"
        title="Trace citations"
      />
    </div>
  </div>
</section>
