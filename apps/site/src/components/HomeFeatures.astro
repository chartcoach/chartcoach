---
import FeatureCard from "./home/FeatureCard.astro";
---

<section class="cc-home-overview grid gap-4" aria-labelledby="cc-home-overview-title">
	<div class="cc-home-overview__copy max-w-3xl">
		<h2 id="cc-home-overview-title" class="cc-home-section__title">
			A catalog you can read, filter, and cite.
		</h2>
		<p class="cc-home-section__lede">
			Chart Coach turns visualization advice into structured entries that stay pleasant for
			people and precise enough for retrieval, feedback, and analysis workflows.
		</p>
	</div>
	<ul
		class="cc-home-overview__qualities grid gap-3 md:grid-cols-3"
		aria-label="Catalog qualities"
	>
		<li>Readable enough to skim quickly</li>
		<li>Structured enough to browse systematically</li>
		<li>Grounded enough to trace back to evidence</li>
	</ul>
</section>

<section class="cc-home-explore grid gap-4" aria-labelledby="cc-home-explore-title">
	<div class="cc-home-explore__header max-w-3xl">
		<h2 id="cc-home-explore-title" class="cc-home-section__title">Explore the catalog</h2>
		<p class="cc-home-section__lede">
			Choose the entry point that matches how you want to work with the material.
		</p>
	</div>

	<div class="cc-features cc-home-features grid gap-4 md:grid-cols-2" aria-label="Explore Chart Coach">
		<FeatureCard
			description="Read concise recommendations with context, labels, and references already in place."
			href="/guidelines/"
			icon="catalog"
			title="Browse the catalog"
		/>
		<FeatureCard
			description="Narrow the collection by task, audience, chart type, communication goal, or constraint."
			href="/labels/"
			icon="labels"
			title="Filter by labels"
		/>
		<FeatureCard
			description="Understand how the catalog is organized when you want the full model behind each entry."
			href="/catalog/"
			icon="structure"
			title="Inspect the structure"
		/>
		<FeatureCard
			description="Follow citations back to the bibliography and inspect the evidence behind each claim."
			href="/catalog/#references"
			icon="citations"
			title="Trace citations"
		/>
	</div>
</section>
