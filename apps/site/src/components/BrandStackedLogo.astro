---
import { brandAssets } from "@chartcoach/brand";

interface Props {
  class?: string;
}

const className = Astro.props.class;
---

<span class:list={["chartcoach-brand-logo", className]} aria-hidden="true">
  <img
    src={brandAssets.squareLight}
    alt=""
    class="chartcoach-brand-logo__image chartcoach-brand-logo__image--light"
    loading="lazy"
    decoding="async"
  />
  <img
    src={brandAssets.squareDark}
    alt=""
    class="chartcoach-brand-logo__image chartcoach-brand-logo__image--dark"
    loading="lazy"
    decoding="async"
  />
</span>
