---
import GuidelinesPagination from "@/components/GuidelinesPagination.astro";
import { type GuidelineEntry } from "@/lib/guidelines-pagination";

type Props = {
  guidelines: GuidelineEntry[];
  currentPage: number;
  totalPages: number;
  totalRecords: number;
};

const { guidelines, currentPage, totalPages, totalRecords } = Astro.props;
const MAX_VISIBLE_LABELS = 5;
---

<section class="px-6 py-[clamp(4.5rem,10vh,7rem)]">
  <div class="mx-auto w-full max-w-[72rem]">
    <p class="m-0 font-mono text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-muted">Catalog</p>
    <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(28rem,35rem)] lg:items-end">
      <div>
        <h1 class="m-0 max-w-[42rem] text-[2.75rem] font-semibold leading-[1.02] tracking-normal text-fg sm:text-[3.5rem] lg:text-[4.5rem]">
          Guideline Catalog
        </h1>
        <p class="m-0 mt-5 max-w-[44rem] text-[1.0625rem] leading-[1.65] text-muted lg:text-[1.1875rem]">
          Browse guideline summaries, then open one to inspect the full guidance and sources.
        </p>
      </div>
      <GuidelinesPagination
        currentPage={currentPage}
        totalPages={totalPages}
        totalRecords={totalRecords}
        class="lg:mt-0"
      />
    </div>

    <ol class="mt-12 grid list-none gap-px overflow-hidden rounded-2xl border border-border bg-border p-0 text-left [grid-auto-rows:1fr] sm:grid-cols-2 lg:grid-cols-3">
      {
        guidelines.map((guideline) => {
          const visibleLabels = guideline.data.labels.slice(0, MAX_VISIBLE_LABELS);
          const hiddenLabelCount = guideline.data.labels.length - visibleLabels.length;

          return (
            <li class="bg-bg transition-colors hover:bg-surface-muted">
              <a
                href={`/guidelines/${guideline.id}/`}
                class="flex h-full min-h-[20rem] flex-col p-5 text-fg no-underline sm:p-6"
              >
                <h2 class="m-0 min-h-[4.9rem] overflow-hidden text-[1.0625rem] font-semibold leading-snug tracking-normal [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:3] lg:text-[1.1875rem]">
                  {guideline.data.title}
                </h2>
                {guideline.data.description ? (
                  <p class="m-0 mt-4 min-h-[7.5rem] overflow-hidden text-[0.9375rem] leading-[1.6] text-muted [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:5] lg:text-[1rem]">
                    {guideline.data.description}
                  </p>
                ) : (
                  <span class="mt-4 min-h-[7.5rem]" aria-hidden="true"></span>
                )}
                {visibleLabels.length > 0 && (
                  <ul class="m-0 flex min-h-[4.75rem] list-none content-start flex-wrap gap-2 pt-6">
                    {visibleLabels.map((label) => (
                      <li>
                        <span class="inline-flex rounded-md bg-surface-muted px-2 py-1 font-mono text-[0.6875rem] text-muted">
                          {label}
                        </span>
                      </li>
                    ))}
                    {hiddenLabelCount > 0 && (
                      <li>
                        <span
                          class="inline-flex rounded-md bg-surface-muted px-2 py-1 font-mono text-[0.6875rem] text-muted"
                          title={`${hiddenLabelCount} more labels`}
                        >
                          +{hiddenLabelCount}
                        </span>
                      </li>
                    )}
                  </ul>
                )}
              </a>
            </li>
          );
        })
      }
    </ol>

    <GuidelinesPagination
      currentPage={currentPage}
      totalPages={totalPages}
      totalRecords={totalRecords}
      class="mt-10 pt-8"
    />
  </div>
</section>
