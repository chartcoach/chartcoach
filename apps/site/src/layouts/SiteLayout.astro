---
import { brandAssets } from "@chartcoach/brand";
import "@chartcoach/brand/fonts.css";
import "@/styles/site.css";
import SiteShell from "@/components/SiteShell.astro";
import { getSiteRuntimeConfig } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? "chartcoach";
const description =
  Astro.props.description ??
  "chartcoach helps chart agents review charts with guidance they can inspect and cite.";
const pageTitle = title === "chartcoach" ? "chartcoach" : `${title} | chartcoach`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const { isPreviewDeployment } = getSiteRuntimeConfig();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {isPreviewDeployment && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <link rel="icon" type="image/svg+xml" href={brandAssets.favicon} />
    <link rel="alternate icon" type="image/png" sizes="32x32" href={brandAssets.faviconPng} />
    <link rel="apple-touch-icon" href={brandAssets.appleTouchIcon} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {canonical && <link rel="canonical" href={canonical} />}
    <script is:inline>
      (() => {
        const storageKey = "chartcoach-theme";
        const root = document.documentElement;
        const stored = localStorage.getItem(storageKey);
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = stored ? stored === "dark" : prefersDark;
        const platform =
          navigator.userAgentData?.platform ??
          String(Reflect.get(navigator, "platform") ?? "");
        const isApple =
          /mac|iphone|ipad|ipod/i.test(platform) ||
          (platform === "MacIntel" && navigator.maxTouchPoints > 1);
        root.classList.toggle("dark", isDark);
        root.classList.toggle("os-apple", isApple);
        root.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <SiteShell>
      <slot />
    </SiteShell>
  </body>
</html>
