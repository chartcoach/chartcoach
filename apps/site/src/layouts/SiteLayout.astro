---
import { Menu, Moon, Sun } from "@lucide/astro";

import { getSiteLinks } from "@/config/site";
import { getSiteNavigation, getSiteSocialLinks } from "@/config/navigation";
import "@/styles/site.css";

interface Props {
  title?: string;
  description?: string;
  contentClass?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    contentClass?: string;
  };
}

const {
  title: explicitTitle,
  description: explicitDescription,
  contentClass: explicitContentClass,
  frontmatter,
} = Astro.props as Props;

const title = explicitTitle ?? frontmatter?.title ?? "ChartCoach";
const description =
  explicitDescription ??
  frontmatter?.description ??
  "Browse ChartCoach guideline records with labels, sections, and source references.";
const contentClass = explicitContentClass ?? frontmatter?.contentClass ?? "";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const pageTitle = title === "ChartCoach" ? "ChartCoach" : `${title} | ChartCoach`;
const { docsUrl } = getSiteLinks();
const siteNavigation = getSiteNavigation();
const siteSocialLinks = getSiteSocialLinks();
const siteInnerClasses =
  "mx-auto w-[min(100%_-_2rem,var(--page-width))] max-[24rem]:w-[min(100%_-_1.5rem,var(--page-width))]";
const navLinkClasses =
  "rounded-sm px-[0.68rem] py-[0.48rem] text-[0.84rem] font-semibold text-muted-ink no-underline transition-[background-color,color,border-color,transform] hover:bg-[var(--surface-panel)] hover:text-ink active:scale-[0.98] [&[aria-current=page]]:bg-[var(--surface-panel)] [&[aria-current=page]]:text-ink";
const headerActionClasses =
  "inline-flex min-h-[2.15rem] min-w-[2.15rem] cursor-pointer items-center justify-center rounded-sm border border-transparent bg-transparent px-[0.58rem] py-[0.4rem] text-[0.84rem] font-semibold text-muted-ink no-underline transition-[background-color,color,border-color,transform] hover:bg-[var(--surface-panel)] hover:text-ink active:scale-[0.98] [&_svg]:size-4";
const mobilePanelLinkClasses =
  "rounded-sm px-3 py-[0.68rem] text-[0.9rem] font-semibold text-ink no-underline transition-[background-color,transform] hover:bg-[var(--surface-panel)] active:scale-[0.98] [&[aria-current=page]]:bg-[var(--surface-panel)]";
const footerLinkClasses = "font-semibold text-ink no-underline";

function isActive(href: string) {
  if (href === "/") return Astro.url.pathname === "/";
  return href.startsWith("/") && Astro.url.pathname.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <script is:inline>
      (() => {
        const key = "chartcoach-theme";
        const saved = window.localStorage.getItem(key);
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = saved === "light" || saved === "dark" ? saved : prefersDark ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="min-h-screen bg-canvas">
      <header class="sticky top-0 z-40 border-b border-line bg-[color-mix(in_srgb,var(--canvas)_94%,transparent)] backdrop-blur-[16px]">
        <div class:list={[siteInnerClasses, "flex min-h-[var(--site-header-height)] items-center justify-between gap-4"]}>
          <a class="whitespace-nowrap font-display text-[1.05rem] font-bold leading-none text-ink no-underline" href="/" aria-label="ChartCoach home">ChartCoach</a>
          <nav class="hidden items-center gap-[0.2rem] min-[52rem]:flex" aria-label="Primary">
            {
              siteNavigation.map((item) => (
                <a
                  class={navLinkClasses}
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noreferrer" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="flex items-center gap-[0.4rem]">
            <button
              class={headerActionClasses}
              type="button"
              data-theme-toggle
              aria-label="Toggle color theme"
            >
              <Sun class="theme-icon-light" aria-hidden="true" focusable="false" />
              <Moon class="theme-icon-dark" aria-hidden="true" focusable="false" />
            </button>
            {
              siteSocialLinks.map((link) => (
                <a
                  class={headerActionClasses}
                  href={link.href}
                  aria-label={link.label}
                  rel="noreferrer"
                  target="_blank"
                >
                  <span>{link.label}</span>
                </a>
              ))
            }
            <details class="relative min-[52rem]:hidden">
              <summary
                class:list={[headerActionClasses, "list-none [&::-webkit-details-marker]:hidden"]}
                aria-label="Open navigation"
                role="button"
              >
                <Menu aria-hidden="true" focusable="false" />
                <span class="sr-only">Open navigation</span>
              </summary>
              <nav
                class="absolute right-0 top-[calc(100%+0.5rem)] grid w-[min(16rem,calc(100vw_-_2rem))] gap-[0.2rem] rounded-sm border border-line bg-surface p-[0.45rem] shadow-[0_16px_40px_color-mix(in_srgb,var(--ink)_16%,transparent)]"
                aria-label="Mobile"
              >
                {
                  siteNavigation.map((item) => (
                    <a
                      class={mobilePanelLinkClasses}
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noreferrer" : undefined}
                    >
                      {item.label}
                    </a>
                  ))
                }
              </nav>
            </details>
          </div>
        </div>
      </header>
      <main class:list={["min-w-0", contentClass]}>
        <slot />
      </main>
      <footer class="border-t border-line py-[1.6rem] text-muted-ink">
        <div class:list={[siteInnerClasses, "flex flex-wrap items-center justify-between gap-x-4 gap-y-3 text-[0.84rem] max-[46rem]:items-start"]}>
          <span>ChartCoach keeps visualization guidance source-backed and inspectable.</span>
          <nav class="flex flex-wrap items-center justify-end gap-x-4 gap-y-3 max-[46rem]:justify-start" aria-label="Footer">
            <a class={footerLinkClasses} href="/guidelines/">Guidelines</a>
            <a class={footerLinkClasses} href="/getting-started/">Get started</a>
            <a class={footerLinkClasses} href={docsUrl}>Technical docs</a>
          </nav>
        </div>
      </footer>
    </div>
    <script>
      const themeKey = "chartcoach-theme";

      function currentTheme() {
        return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      }

      function setTheme(theme: "light" | "dark") {
        document.documentElement.dataset.theme = theme;
        window.localStorage.setItem(themeKey, theme);
        for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
          button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
        }
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
        button.addEventListener("click", () => {
          setTheme(currentTheme() === "dark" ? "light" : "dark");
        });
      }

      setTheme(currentTheme());
    </script>
  </body>
</html>
