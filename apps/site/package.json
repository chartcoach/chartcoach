{
  "name": "@chartcoach/site",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../../packages/brand check:assets && astro build",
    "dev": "portless",
    "dev:app": "astro dev --host 127.0.0.1 --port ${PORT:-4321}",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . && astro check",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@chartcoach/brand": "workspace:*",
    "@chartcoach/catalog": "workspace:*",
    "@orama/orama": "^3.1.18",
    "astro": "7.0.0",
    "citation-js": "^0.7.22",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "jsdom": "^29.1.1",
    "satori": "^0.26.0",
    "tailwindcss": "^4.3.1",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3"
  },
  "portless": {
    "name": "chartcoach",
    "script": "dev:app"
  }
}
