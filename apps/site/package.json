{
  "name": "@chartcoach/site",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prebuild": "vp run @chartcoach/catalog#build",
    "build": "CHARTCOACH_SITE_CATALOG_SOURCE=${CHARTCOACH_SITE_CATALOG_SOURCE:-../../fixtures/catalog-release} astro build",
    "check": "vp check",
    "dev": "portless",
    "dev:app": "astro dev --host 127.0.0.1 --port ${PORT:-4321}",
    "test": "vp test",
    "pretypecheck": "vp run @chartcoach/catalog#build",
    "typecheck": "CHARTCOACH_SITE_CATALOG_SOURCE=${CHARTCOACH_SITE_CATALOG_SOURCE:-../../fixtures/catalog-release} astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@chartcoach/brand": "workspace:*",
    "@chartcoach/catalog": "workspace:*",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "catalog:",
    "@orama/orama": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "catalog:",
    "citation-js": "^0.8.2",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanitize-html": "^2.17.7",
    "satori": "^0.29.0",
    "turndown": "^7.2.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "portless": {
    "name": "chartcoach",
    "script": "dev:app"
  }
}
