{
  "name": "@chartcoach/site",
  "version": "0.3.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prebuild": "vp run @chartcoach/catalog#build",
    "build": "astro build",
    "check": "vp check",
    "dev": "portless",
    "predev:app": "vp run @chartcoach/catalog#build",
    "dev:app": "trap 'exit 0' INT TERM; ASTRO_DEV_BACKGROUND=0 astro dev --ignore-lock --host 127.0.0.1 --port ${PORT:-4321}",
    "test": "vp test",
    "pretypecheck": "vp run @chartcoach/catalog#build",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@chartcoach/brand": "workspace:*",
    "@chartcoach/catalog": "workspace:*",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "refkit-js": "0.3.0",
    "sanitize-html": "^2.17.7",
    "satori": "^0.29.1",
    "turndown": "^7.2.4",
    "zbsearch": "4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "portless": {
    "name": "chartcoach",
    "script": "dev:app",
    "proxy": true
  }
}
