## Eval UI
#
# Where guideline cards link for full details.
# Use `{id}` as the placeholder (guideline slug/id).
#
# Example:
# VITE_GUIDELINE_DETAIL_URL_TEMPLATE=https://chartcoach.hci.mbzuai.ac.ae/guidelines/{id}/
#
VITE_GUIDELINE_DETAIL_URL_TEMPLATE=

## Eval UI (strategy display; server/runtime only)
#
# Controls how strategies are labeled in the UI:
# - name: show strategy names (default)
# - alias: show "Strategy A/B/C…" (alphabetical by strategy name)
#
# Example:
# STRATEGY_DISPLAY_MODE=alias
#
STRATEGY_DISPLAY_MODE=

## Eval UI (S3 sync uploads; server/runtime only)
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PREFIX=chartcoach
# S3_FORCE_PATH_STYLE=false
