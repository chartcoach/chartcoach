{
  "name": "@chartcoach/visground-viewer",
  "version": "0.1.0",
  "private": true,
  "files": [
    "distlib"
  ],
  "type": "module",
  "main": "./distlib/index.js",
  "types": "./distlib/index.d.ts",
  "exports": {
    ".": {
      "types": "./distlib/index.d.ts",
      "chartcoach-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": "./distlib/index.js",
      "default": "./distlib/index.js"
    }
  },
  "scripts": {
    "dev": "pnpm --dir ../visground export:viewer-data && vite --config vite.config.app.js",
    "build:lib": "vite build --config vite.config.lib.js && tsc -b tsconfig.build.json --force",
    "build:watch": "sh -c 'vite build --config vite.config.lib.js --watch & tsc -b tsconfig.build.json --watch --preserveWatchOutput & wait'",
    "build:web": "pnpm --dir ../visground export:viewer-data && vite build --config vite.config.app.js",
    "build": "pnpm build:lib && pnpm build:web",
    "preview": "vite preview --config vite.config.app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chartcoach/ui": "workspace:*",
    "@floating-ui/react": "^0.27.19",
    "clsx": "^2.1.1",
    "hyparquet": "^1.25.5",
    "hyparquet-compressors": "^1.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "agentation": "^3.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
