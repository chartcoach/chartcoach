{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@chartcoach/visground-viewer": ["../../packages/visground-viewer/src/index.ts"],
      "@/*": ["../../packages/visground-viewer/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["js/**/*.ts"]
}
