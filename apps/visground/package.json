{
  "name": "visground",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:anywidget": "vite --config vite.config.anywidget.js",
    "build:anywidget": "vite build --config vite.config.anywidget.js",
    "build": "pnpm build:anywidget",
    "test": "PYTHONPATH=src uv run pytest tests",
    "typecheck:js": "tsc -p tsconfig.json --noEmit",
    "typecheck:py": "PYTHONPATH=src uv run ty check src tests",
    "typecheck": "pnpm typecheck:js && pnpm typecheck:py",
    "lint:js": "oxlint .",
    "lint:py": "uv run ruff check src tests scripts workbench",
    "lint": "pnpm lint:js && pnpm lint:py",
    "format:js": "oxfmt .",
    "format:py": "uv run ruff format src tests scripts workbench",
    "format": "pnpm format:js && pnpm format:py"
  },
  "dependencies": {
    "@chartcoach/visground-viewer": "workspace:*"
  },
  "devDependencies": {
    "@anywidget/vite": "^0.2.2",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  }
}
