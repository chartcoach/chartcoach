{
  "name": "@chartcoach/visground-anywidget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "export:viewer-data": "uv run python -m visground.viewer.export",
    "dev:anywidget": "pnpm export:viewer-data && vite --config vite.config.anywidget.js",
    "serve:charts": "uv run python -m http.server 8000 --bind 127.0.0.1 --directory data/artifacts/charts",
    "build:anywidget": "pnpm export:viewer-data && vite build --config vite.config.anywidget.js",
    "build": "pnpm --filter @chartcoach/visground-viewer build && vite build --config vite.config.anywidget.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chartcoach/visground-viewer": "workspace:*"
  },
  "devDependencies": {
    "@anywidget/vite": "^0.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
