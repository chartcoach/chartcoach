{
  "name": "chartcoach",
  "version": "0.2.0",
  "description": "Run ChartCoach locally: visualization advice grounded in a source-traced guideline catalog.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chartcoach/chartcoach.git",
    "directory": "apps/chat"
  },
  "bin": {
    "chartcoach": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "predev": "node scripts/prepare-duckdb.mjs && vp run @chartcoach/catalog#build",
    "dev": "portless",
    "dev:app": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-duckdb.mjs && vp run @chartcoach/catalog#build",
    "build": "pnpm build:eve && next build && vp pack && node scripts/package.mjs",
    "build:eve": "eve build && node scripts/verify-skills.mjs",
    "start": "node dist/cli/index.mjs chat --no-open",
    "check": "vp check && eve info",
    "pretypecheck": "vp run @chartcoach/catalog#build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vp test && node --test test/*.test.mjs",
    "eval": "eve eval --strict"
  },
  "dependencies": {
    "@chartcoach/catalog": "workspace:*",
    "@duckdb/node-api": "catalog:",
    "@effect/experimental": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@lancedb/lancedb": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "commander": "15.0.0",
    "effect": "catalog:",
    "env-paths": "catalog:",
    "eve": "catalog:",
    "http-proxy-3": "2.0.1",
    "just-bash": "catalog:",
    "open": "11.0.3",
    "proper-lockfile": "4.1.2",
    "sirv": "3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "@assistant-ui/eve": "catalog:",
    "@assistant-ui/react": "catalog:",
    "@chartcoach/brand": "workspace:*",
    "@chartcoach/skills": "workspace:*",
    "@commander-js/extra-typings": "15.0.0",
    "@duckdb/duckdb-wasm": "catalog:",
    "@effect/opentelemetry": "catalog:",
    "@langfuse/otel": "catalog:",
    "@lobehub/icons": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@stylexjs/babel-plugin": "catalog:",
    "@stylexjs/postcss-plugin": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@uwdata/mosaic-core": "catalog:",
    "@uwdata/mosaic-sql": "catalog:",
    "ai": "catalog:",
    "autoprefixer": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "nitro": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "srvx": "1.0.3",
    "streamdown": "catalog:",
    "typescript": "catalog:",
    "unplugin": "catalog:",
    "virtua": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "portless": {
    "name": "chat.chartcoach",
    "script": "dev:app"
  }
}
