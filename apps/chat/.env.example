# The CLI loads .env in its working directory; process environment and flags win.
# Omit catalog settings to use the official release and its local embedding profile.
# CHARTCOACH_CATALOG=./release
# CHARTCOACH_CATALOG_PROFILE=compatible

# Optional shared text/vision connection. Otherwise connect in Model settings.
CHARTCOACH_TEXT_PROVIDER=compatible
# CHARTCOACH_TEXT_BASE_URL=<openai-compatible-api-url>
# CHARTCOACH_TEXT_MODEL=<text-model-with-images-and-tools>
# CHARTCOACH_TEXT_API_KEY=<private-text-provider-key>
# CHARTCOACH_TEXT_API_KEY_ENV=TEXT_TOKEN

# Optional remote query embeddings; omit to use the supported local MiniLM profile.
# Model, dimensions, and base URL must match the selected catalog profile.
# CHARTCOACH_EMBEDDING_MODEL=<embedding-model-id>
# CHARTCOACH_EMBEDDING_DIMENSIONS=<model-dimensions>
# CHARTCOACH_EMBEDDING_BASE_URL=<openai-compatible-api-url>
# CHARTCOACH_EMBEDDING_API_KEY=<private-embedding-provider-key>
# CHARTCOACH_EMBEDDING_API_KEY_ENV=VECTOR_TOKEN

CHARTCOACH_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=<your-project-region-or-self-hosted-url>
