# Copy to chat.env and run: npx chartcoach chat --env-file ./chat.env
# Explicit files override inherited values. Automatic .env keeps inherited values.

# Hosted preset or native adapter. openrouter supplies its API URL.
# Native adapters: openai, anthropic, google. Custom Chat Completions: compatible.
CHARTCOACH_TEXT_PROVIDER=openrouter
# CHARTCOACH_TEXT_MODEL=<model-supporting-images-and-tool-calls>
# CHARTCOACH_TEXT_API_KEY=<private-provider-key>
# CHARTCOACH_TEXT_BASE_URL=<custom-api-url-or-preset-override>
# CHARTCOACH_TEXT_AUTH=api-key
# CHARTCOACH_TEXT_CONTEXT_WINDOW=128000
# CHARTCOACH_TEXT_API_KEY_ENV=TEXT_TOKEN

# Local listener. Network listeners require CHARTCOACH_PASSWORD or a password file.
CHARTCOACH_HOST=127.0.0.1
CHARTCOACH_PORT=4273
CHARTCOACH_OPEN=false
# CHARTCOACH_PUBLIC_URL=https://chat.example.org
# CHARTCOACH_PASSWORD=<private-server-password>
# CHARTCOACH_PASSWORD_FILE=/run/secrets/chartcoach-password
# Serve without sign-in instead, for a public deployment.
# CHARTCOACH_PUBLIC=true
# CHARTCOACH_DATA_DIR=<persistent-chat-directory>
# CHARTCOACH_CACHE_DIR=<shared-catalog-cache>

# Guideline links use URL-encoded IDs. Images default to <guideline-url>/og.png.
CHARTCOACH_GUIDELINE_URL_TEMPLATE=https://chartcoach.dev/guidelines/{id}
# CHARTCOACH_GUIDELINE_IMAGE_URL_TEMPLATE=https://images.example/{id}.png

# Omit catalog settings to use the official release and local MiniLM embeddings.
# CHARTCOACH_CATALOG=./release
# CHARTCOACH_CATALOG_PROFILE=minilm-l6-v2-cpu

# Remote query embeddings must match the selected catalog profile.
# CHARTCOACH_EMBEDDING_MODEL=<embedding-model-id>
# CHARTCOACH_EMBEDDING_DIMENSIONS=<model-dimensions>
# CHARTCOACH_EMBEDDING_BASE_URL=<openai-compatible-api-url>
# CHARTCOACH_EMBEDDING_API_KEY=<private-embedding-key>
# CHARTCOACH_EMBEDDING_API_KEY_ENV=VECTOR_TOKEN

# Enabling tracing requires both project keys. Use the project's region or host.
CHARTCOACH_TRACING=false
# LANGFUSE_PUBLIC_KEY=<public-project-key>
# LANGFUSE_SECRET_KEY=<secret-project-key>
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=<deployment-version>

# Complete environment and JSON reference: https://github.com/chartcoach/chartcoach/blob/main/apps/chat/README.md
