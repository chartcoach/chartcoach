{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@chartcoach/catalog": ["./src/index.ts"],
      "@chartcoach/catalog/node": ["./src/node.ts"],
      "@chartcoach/catalog/browser": ["./src/browser.ts"]
    },

    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
