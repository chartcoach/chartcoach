{
  "name": "@chartcoach/catalog",
  "version": "0.1.6",
  "description": "JavaScript models and artifact parsers for the chartcoach visualization guideline catalog.",
  "bugs": {
    "url": "https://github.com/chartcoach/chartcoach/issues"
  },
  "license": "MIT",
  "author": "Péter Ferenc Gyarmati <dev.petergy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chartcoach/chartcoach.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "oxfmt src test scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts",
    "format:check": "oxfmt src test scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts --check",
    "lint": "oxlint .",
    "prepack": "pnpm run build",
    "sync:defaults": "node scripts/sync-chartcoach-defaults.mjs",
    "sync:defaults:check": "node scripts/sync-chartcoach-defaults.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hyparquet": "^1.26.1",
    "hyparquet-compressors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
