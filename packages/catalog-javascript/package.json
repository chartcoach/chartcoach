{
  "name": "@chartcoach/catalog",
  "version": "0.1.0",
  "description": "JavaScript loaders and wire types for the ChartCoach visualization guideline catalog.",
  "private": true,
  "license": "MIT",
  "author": "Péter Ferenc Gyarmati <dev.petergy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-gy/chartcoach.git",
    "directory": "packages/catalog-javascript"
  },
  "bugs": {
    "url": "https://github.com/peter-gy/chartcoach/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "source": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "source": "./src/browser.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hyparquet": "^1.26.0",
    "hyparquet-compressors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "oxlint": "^1.66.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
