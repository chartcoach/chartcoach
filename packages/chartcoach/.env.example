# chartcoach mcp loads .env in its working directory. Process environment wins.
# Catalog locations and profile IDs are deployment inputs; omit for the official catalog.
# CHARTCOACH_SOURCE=./release
# CHARTCOACH_INDEX_PROFILE=compatible
CHARTCOACH_MCP_TRANSPORT=streamable-http
CHARTCOACH_MCP_HOST=0.0.0.0
CHARTCOACH_MCP_PUBLIC_URL=https://mcp.chartcoach.dev
# CHARTCOACH_MCP_TOKEN=<private-deployment-token>

# Dedicated OpenAI-compatible embedding connection. Fill in your provider's values.
# The model, dimensions, and URL create a release profile; the MCP server uses
# that profile's identity. It resolves credentials independently at startup.
# CHARTCOACH_EMBEDDING_MODEL=<embedding-model-id>
# CHARTCOACH_EMBEDDING_DIMENSIONS=<model-dimensions>
# CHARTCOACH_EMBEDDING_BASE_URL=<openai-compatible-api-url>
# CHARTCOACH_EMBEDDING_API_KEY=<private-provider-key>
# To keep the key under another environment name, set this selector.
# CHARTCOACH_EMBEDDING_API_KEY_ENV=VECTOR_TOKEN
# Alternatively use a private JSON variable file; its values win over env.
# CHARTCOACH_EMBEDDING_VARS=/run/secrets/embedding-vars.json
