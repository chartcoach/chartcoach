# chartcoach mcp loads .env in its working directory. Process environment wins.
CHARTCOACH_SOURCE=https://chartcoach.dev/catalog.json
# Select a profile published by this release to expose the search tool.
# CHARTCOACH_INDEX_PROFILE=openrouter
CHARTCOACH_MCP_TRANSPORT=streamable-http
CHARTCOACH_MCP_HOST=0.0.0.0
CHARTCOACH_MCP_PORT=8000
CHARTCOACH_MCP_PUBLIC_URL=https://mcp.chartcoach.dev
CHARTCOACH_MCP_PATH=/mcp
CHARTCOACH_MCP_SQL_TIMEOUT=5
# Set a deployment secret; clients send Authorization: Bearer <value>.
# CHARTCOACH_MCP_TOKEN=

# Only variables named by the selected profile's $var: bindings are consumed.
# OPENROUTER_API_KEY=
# Alternatively supply a private JSON variable file. Its values win over env.
# CHARTCOACH_EMBEDDING_VARS=/run/secrets/embedding-vars.json

# These are inputs for the documented profile-build example, not runtime
# overrides of stored vectors. Publish/select a new profile when changing them.
CHARTCOACH_EMBEDDING_MODEL=openai/text-embedding-3-small
CHARTCOACH_EMBEDDING_DIMENSIONS=1536
CHARTCOACH_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
