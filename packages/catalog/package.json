{
  "name": "@chartcoach/catalog",
  "version": "0.3.2",
  "description": "JavaScript models and artifact parsers for the chartcoach visualization guideline catalog.",
  "bugs": {
    "url": "https://github.com/chartcoach/chartcoach/issues"
  },
  "license": "Apache-2.0",
  "author": "Péter Ferenc Gyarmati <dev.petergy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chartcoach/chartcoach.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./node/paths": {
      "types": "./dist/node/paths.d.ts",
      "source": "./src/node/paths.ts",
      "default": "./dist/node/paths.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./duckdb": {
      "types": "./dist/duckdb.d.ts",
      "source": "./src/duckdb.ts",
      "default": "./dist/duckdb.js"
    },
    "./duckdb-wasm": {
      "types": "./dist/duckdb-wasm.d.ts",
      "source": "./src/duckdb-wasm.ts",
      "default": "./dist/duckdb-wasm.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "source": "./src/node.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepack": "vp run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hyparquet": ">=1.29.2",
    "hyparquet-compressors": ">=1.1.1",
    "refkit-js": ">=0.3.0",
    "tar": ">=7.5.22",
    "yaml": ">=2.9.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@duckdb/node-api": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": ">=1.33.1-dev57.0",
    "@duckdb/node-api": ">=1.5.5-r.4"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
