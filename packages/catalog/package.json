{
  "name": "@chartcoach/catalog",
  "version": "0.2.0",
  "description": "JavaScript models and artifact parsers for the chartcoach visualization guideline catalog.",
  "bugs": {
    "url": "https://github.com/chartcoach/chartcoach/issues"
  },
  "license": "Apache-2.0",
  "author": "Péter Ferenc Gyarmati <dev.petergy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chartcoach/chartcoach.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "source": "./src/node.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepack": "vp run build",
    "test": "vp test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hyparquet": ">=1.29.2",
    "hyparquet-compressors": ">=1.1.1",
    "refkit-js": ">=0.3.0",
    "yaml": ">=2.9.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
