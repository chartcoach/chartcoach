{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@chartcoach/ui": ["./src/index.ts"],
      "#components/*": ["./src/components/*.tsx"],
      "#lib/*": ["./src/lib/*.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
