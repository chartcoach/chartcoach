{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],

    "baseUrl": ".",
    "paths": {
      "@chartcoach/ui": ["./src/index.ts"]
    },

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
