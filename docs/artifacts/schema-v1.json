{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_schema_version": 1,
  "documents": {
    "bundle": {
      "$defs": {
        "CatalogEntry": {
          "description": "Base class for entries in the catalog. A catalog entry is a folder that contains a guideline and all its assets, such as the reference .bib file, images, and example code.",
          "properties": {
            "guideline": {
              "$ref": "#/$defs/Guideline",
              "description": "The guideline entry associated with this catalog entry."
            },
            "references": {
              "description": "BibTeX-formatted bibliography content for citations used in the guideline.",
              "items": {
                "type": "string"
              },
              "title": "References",
              "type": "array"
            }
          },
          "required": [
            "guideline"
          ],
          "title": "CatalogEntry",
          "type": "object"
        },
        "EvalEvidenceSnippet": {
          "properties": {
            "role": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Role"
            },
            "score": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Score"
            },
            "text": {
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "title": "EvalEvidenceSnippet",
          "type": "object"
        },
        "EvalGuidelineResult": {
          "properties": {
            "entry": {
              "$ref": "#/$defs/CatalogEntry"
            },
            "evidence": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/EvalEvidenceSnippet"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Evidence"
            },
            "rank": {
              "minimum": 1,
              "title": "Rank",
              "type": "integer"
            },
            "score": {
              "exclusiveMinimum": 0,
              "title": "Score",
              "type": "number"
            }
          },
          "required": [
            "rank",
            "score",
            "entry"
          ],
          "title": "EvalGuidelineResult",
          "type": "object"
        },
        "EvalStrategyResult": {
          "properties": {
            "guidelines": {
              "items": {
                "$ref": "#/$defs/EvalGuidelineResult"
              },
              "title": "Guidelines",
              "type": "array"
            },
            "meta": {
              "additionalProperties": true,
              "title": "Meta",
              "type": "object"
            },
            "strategy_id": {
              "minLength": 1,
              "title": "Strategy Id",
              "type": "string"
            },
            "strategy_name": {
              "minLength": 1,
              "title": "Strategy Name",
              "type": "string"
            }
          },
          "required": [
            "strategy_id",
            "strategy_name"
          ],
          "title": "EvalStrategyResult",
          "type": "object"
        },
        "Guideline": {
          "description": "Structured representation of a visualization design guideline.",
          "properties": {
            "bibliography": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Path to the bibliography file for citations",
              "title": "Bibliography"
            },
            "body": {
              "description": "Full markdown content containing structured sections with role annotations (e.g. advice, reason, situation, considerations, checks, improvements)",
              "title": "Body",
              "type": "string"
            },
            "description": {
              "description": "Compelling summary of the advice, its core benefit, and when it's most needed -- optimized for both human and AI relevance determination",
              "title": "Description",
              "type": "string"
            },
            "id": {
              "description": "Unique, URL-friendly identifier serving as the guideline's permanent address",
              "examples": [
                "use-direct-labels-not-legends"
              ],
              "title": "Id",
              "type": "string"
            },
            "labels": {
              "description": "Structured key:value tags for discoverability and filtering",
              "examples": [
                [
                  "chart:bar",
                  "goal:comparison",
                  "topic:accessibility",
                  "audience:general",
                  "impact:credibility"
                ]
              ],
              "items": {
                "type": "string"
              },
              "title": "Labels",
              "type": "array"
            },
            "title": {
              "description": "Actionable imperative instruction that serves as the main headline",
              "examples": [
                "Use direct labels, not legends"
              ],
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "description",
            "body"
          ],
          "title": "Guideline",
          "type": "object"
        },
        "ScenarioChart": {
          "properties": {
            "mime": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mime"
            },
            "uri": {
              "minLength": 1,
              "title": "Uri",
              "type": "string"
            }
          },
          "required": [
            "uri"
          ],
          "title": "ScenarioChart",
          "type": "object"
        },
        "ScenarioProvenance": {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source"
            }
          },
          "title": "ScenarioProvenance",
          "type": "object"
        },
        "ScenarioSpec": {
          "properties": {
            "audience": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Audience"
            },
            "chart": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScenarioChart"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "constraints": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Constraints"
            },
            "counterfactual_group_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Counterfactual Group Id"
            },
            "designer_intent": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Designer Intent"
            },
            "domain": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Domain"
            },
            "id": {
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "lang": {
              "default": "en",
              "title": "Lang",
              "type": "string"
            },
            "medium": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Medium"
            },
            "negative_guideline_ids": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Negative Guideline Ids"
            },
            "provenance": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScenarioProvenance"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "query": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Query"
            },
            "risk_tolerance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Risk Tolerance"
            },
            "time_budget": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Time Budget"
            },
            "title": {
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title"
          ],
          "title": "ScenarioSpec",
          "type": "object"
        }
      },
      "properties": {
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        },
        "generated_at": {
          "minLength": 1,
          "title": "Generated At",
          "type": "string"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        },
        "scenario": {
          "$ref": "#/$defs/ScenarioSpec"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "strategies": {
          "items": {
            "$ref": "#/$defs/EvalStrategyResult"
          },
          "title": "Strategies",
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "digest",
        "scenario",
        "strategies"
      ],
      "title": "EvalScenarioBundleArtifact",
      "type": "object"
    },
    "index": {
      "$defs": {
        "ScenarioChart": {
          "properties": {
            "mime": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Mime"
            },
            "uri": {
              "minLength": 1,
              "title": "Uri",
              "type": "string"
            }
          },
          "required": [
            "uri"
          ],
          "title": "ScenarioChart",
          "type": "object"
        },
        "ScenarioProvenance": {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source"
            }
          },
          "title": "ScenarioProvenance",
          "type": "object"
        },
        "ScenarioSpec": {
          "properties": {
            "audience": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Audience"
            },
            "chart": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScenarioChart"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "constraints": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Constraints"
            },
            "counterfactual_group_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Counterfactual Group Id"
            },
            "designer_intent": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Designer Intent"
            },
            "domain": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Domain"
            },
            "id": {
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "lang": {
              "default": "en",
              "title": "Lang",
              "type": "string"
            },
            "medium": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Medium"
            },
            "negative_guideline_ids": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Negative Guideline Ids"
            },
            "provenance": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScenarioProvenance"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "query": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Query"
            },
            "risk_tolerance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Risk Tolerance"
            },
            "time_budget": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Time Budget"
            },
            "title": {
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title"
          ],
          "title": "ScenarioSpec",
          "type": "object"
        },
        "StrategyInfo": {
          "properties": {
            "description": {
              "title": "Description",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "description"
          ],
          "title": "StrategyInfo",
          "type": "object"
        }
      },
      "properties": {
        "generated_at": {
          "minLength": 1,
          "title": "Generated At",
          "type": "string"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/ScenarioSpec"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "strategies": {
          "items": {
            "$ref": "#/$defs/StrategyInfo"
          },
          "title": "Strategies",
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "strategies",
        "scenarios"
      ],
      "title": "EvalArtifactsIndexArtifact",
      "type": "object"
    }
  },
  "title": "ChartCoach Eval Artifacts (v1)"
}
