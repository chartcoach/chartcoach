.git
.github
.DS_Store

# Node / pnpm
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store

# Build outputs / caches
**/dist
**/.astro
**/.cache
**/.turbo
**/.vite
**/.next
**/.output
**/.vercel

# Python caches (repo has python packages too)
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.venv

# Local-only / large
nogit

# Keep the `apps/site` build context lean (monorepo)
packages/*
!packages/chartcoach-js/**
apps/*
!apps/site/**

# Re-ignore build artifacts inside whitelisted paths (override allowlist above)
apps/site/dist
apps/site/dist/**
apps/site/node_modules
apps/site/node_modules/**
apps/site/.astro
apps/site/.astro/**
packages/chartcoach-js/dist
packages/chartcoach-js/dist/**

# Site build loads guideline Markdown; embedding vectors aren't needed.
guidelines/embeddings.parquet
