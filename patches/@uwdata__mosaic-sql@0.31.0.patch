+    const list: SelectClauseNode[] = [];
+
+    const add = (v: unknown, as?: string) => {
+      if (v != null) {
+        list.push(new SelectClauseNode(asNode(v), as ? unquote(as)! : ''));
+      }
+    };
+
+    const visit = (e: PivotUsingEntry) => {
+      if (e == null) return;
