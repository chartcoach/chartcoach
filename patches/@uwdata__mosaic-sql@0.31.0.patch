+      } else {
+        for (const alias in e) add(e[alias], alias);
+      }
+    };
+
+    expr.forEach(e => isArray(e) ? e.forEach(visit) : visit(e));
+    if (list.length === 0) {
+      throw new Error('PivotQuery.using requires at least one expression.');
+    }
+    this._using = this._using.concat(list);
+    return this;
+  }
